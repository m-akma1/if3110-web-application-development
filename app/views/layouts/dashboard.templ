package layouts

import (
	"dbplatform/app/internal/authn"
	"dbplatform/app/views/components"
)

templ Dashboard(title string, user *authn.AuthLayoutUser, activeDBID string, activeTab string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="id" class="h-full bg-slate-900">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ title } - Platform Manajemen Database</title>
		<link href="/static/css/style.css" rel="stylesheet"/>
		<script src="/static/js/htmx.min.js"></script>
		<script defer src="/static/js/alpine.min.js"></script>
	</head>
	<body 
		class="h-full text-slate-100 bg-slate-900 font-sans"
		hx-headers={ `{"X-CSRF-Token": "` + csrfToken + `"}` }
	>
		<div class="flex h-screen overflow-hidden">
			@components.Sidebar(user, activeTab)

			<div class="flex-1 flex flex-col min-w-0 overflow-hidden">
				@components.Navbar(user, activeDBID)

				<main class="flex-1 overflow-y-auto p-6 bg-slate-900">
					{ children... }
				</main>
			</div>
		</div>
	</body>
	</html>
}