package layouts

templ Auth(title string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="id" class="h-full bg-[#121212]">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="csrf-token" content={ csrfToken }/>
			<title>{ title } - Platform Manajemen Database</title>
			<link href="/static/css/style.css" rel="stylesheet"/>
			<script src="/static/js/htmx.min.js"></script>
			<script defer src="/static/js/alpine.min.js"></script>
			<script>
				document.addEventListener('htmx:configRequest', function(evt) {
					var meta = document.querySelector('meta[name="csrf-token"]');
					if (meta && meta.content) {
						evt.detail.headers['X-CSRF-Token'] = meta.content;
					}
				});
			</script>
		</head>
		<body
			class="h-full bg-[#121212] text-zinc-100 font-sans antialiased"
			hx-headers={ `{"X-CSRF-Token": "` + csrfToken + `"}` }
		>
			<div class="min-h-screen flex">
				<!-- Panel Kiri: Gambar Statik (Menggantikan Efek Glow) -->
				<div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-[#121212] border-r border-[#333138] flex-col justify-between p-12">
					<img
						src="/static/img/auth-bg.svg"
						alt="Database Platform Visual"
						class="absolute inset-0 w-full h-full object-cover pointer-events-none select-none"
					/>

					<!-- Brand Header -->
					<div class="relative z-10 flex items-center gap-3">
						<div class="w-10 h-10 rounded-xl bg-[#ceafa3] flex items-center justify-center font-bold text-lg text-[#121212] shadow-md">
							DB
						</div>
						<span class="text-lg font-bold tracking-tight text-white">
							DB Platform
						</span>
					</div>

					<!-- Caption Bawah -->
					<div class="relative z-10 max-w-md space-y-3 bg-[#1c1b1e]/90 border border-[#333138] rounded-2xl p-6">
						<h2 class="text-xl font-bold text-white tracking-tight">
							Kelola seluruh koneksi database dan skema dalam satu tempat.
						</h2>
						<p class="text-xs text-zinc-400 leading-relaxed">
							Pantau tabel, jalankan migrasi skema dengan aman, dan atur kontrol akses berbasis grup secara terpusat.
						</p>
					</div>
				</div>

				<!-- Panel Kanan: Container Form Login / Sign Up -->
				<div class="w-full lg:w-1/2 flex items-center justify-center p-6 sm:p-12 bg-[#121212]">
					<div
						id="auth-form-container"
						class="w-full max-w-md bg-[#1c1b1e] border border-[#333138] rounded-2xl p-6 sm:p-8 shadow-2xl"
					>
						{ children... }
					</div>
				</div>
			</div>
		</body>
	</html>
}
