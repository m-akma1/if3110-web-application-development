package pages

import (
	"dbplatform/app/domain"
	"fmt"
)

templ adminGroupsSection(ov domain.AdminOverview) {
	<div class="space-y-6">
		@adminCard("Matriks Akses Group × Database", "Akses efektif user = akses tertinggi dari seluruh group-nya") {
			if len(ov.Targets) == 0 {
				<p class="p-4 text-xs text-zinc-500">Belum ada database terdaftar. Tambahkan di tab Koneksi Database.</p>
			} else {
				<table class="w-full text-left text-sm text-zinc-300">
					<thead class="bg-[#18171b] text-xs uppercase tracking-wider text-zinc-400 border-b border-[#333138]">
						<tr>
							<th class="px-4 py-3 font-semibold">Group</th>
							for _, t := range ov.Targets {
								<th class="px-4 py-3 font-semibold">{ t.Name }</th>
							}
						</tr>
					</thead>
					<tbody class="divide-y divide-[#333138]">
						for _, g := range ov.Groups {
							<tr>
								<td class="px-4 py-3 text-xs font-semibold text-zinc-100">{ g.Name }</td>
								for _, t := range ov.Targets {
									<td class="px-4 py-3">
										<select
											name="level"
											aria-label={ "Akses " + g.Name + " pada " + t.Name }
											hx-post="/admin/grants"
											hx-trigger="change"
											hx-vals={ fmt.Sprintf(`{"group_id":%q,"database_id":%q}`, g.ID, t.ID) }
											class={ adminSelect }
										>
											for _, lvl := range []string{"NONE", "VIEW_ONLY", "VIEW_EDIT"} {
												<option value={ lvl } selected?={ g.GrantFor(t.ID) == lvl }>{ levelLabel(lvl) }</option>
											}
										</select>
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			}
		}

		@adminCard("Buat Group", "") {
			<form hx-post="/admin/groups" class="p-4 grid grid-cols-1 md:grid-cols-3 gap-3">
				<div>
					<label class={ adminLabel } for="new-group-name">Nama group</label>
					<input id="new-group-name" name="name" required minlength="2" maxlength="64" class={ adminInput } placeholder="Backend Engineers"/>
				</div>
				<div>
					<label class={ adminLabel } for="new-group-desc">Deskripsi</label>
					<input id="new-group-desc" name="description" class={ adminInput }/>
				</div>
				<div class="flex items-end">
					<button type="submit" class={ btnPrimary + " w-full" }>+ Buat Group</button>
				</div>
			</form>
		}

		<div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
			for _, g := range ov.Groups {
				@adminGroupCard(g, ov.Users)
			}
		</div>
	</div>
}

templ adminGroupCard(g domain.GroupItem, users []domain.UserManagementItem) {
	<div class="bg-[#222126] border border-[#333138] rounded-2xl p-4 space-y-3">
		<div class="flex items-start justify-between gap-3">
			<div>
				<div class="text-sm font-bold text-white">
					{ g.Name }
					if g.IsSystem {
						<span class="ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#2c2a30] text-zinc-300">SISTEM</span>
					}
				</div>
				<div class="text-[11px] text-zinc-400">{ g.Description }</div>
			</div>
			if !g.IsSystem {
				<button
					hx-delete={ "/admin/groups/" + g.ID }
					hx-confirm={ "Hapus group " + g.Name + "? Anggota kehilangan akses dari group ini dan kode undangannya ikut terhapus." }
					class={ btnDanger }
				>Hapus</button>
			}
		</div>

		<details class="text-xs">
			<summary class="cursor-pointer text-zinc-400 hover:text-zinc-200">Ubah nama / deskripsi</summary>
			<form hx-post={ "/admin/groups/" + g.ID } class="mt-2 grid grid-cols-1 md:grid-cols-3 gap-2">
				if g.IsSystem {
					<input type="hidden" name="name" value={ g.Name }/>
				} else {
					<input name="name" value={ g.Name } required minlength="2" maxlength="64" aria-label="Nama group" class={ adminInput }/>
				}
				<input name="description" value={ g.Description } aria-label="Deskripsi group" class={ adminInput + " md:col-span-1" }/>
				<button type="submit" class={ btnSmall }>Simpan</button>
			</form>
		</details>

		<div>
			<div class="text-[10px] uppercase tracking-wider text-zinc-500 mb-1.5">{ fmt.Sprintf("Anggota (%d)", g.MemberCount) }</div>
			if g.IsSystem {
				<p class="text-[11px] text-zinc-500">Semua pengguna otomatis menjadi anggota dan tidak dapat dikeluarkan.</p>
			} else {
				<div class="flex flex-wrap gap-1.5">
					if len(g.Members) == 0 {
						<span class="text-[11px] text-zinc-500">Belum ada anggota.</span>
					}
					for _, m := range g.Members {
						<span class="inline-flex items-center gap-1 pl-2 pr-1 py-0.5 rounded-md text-[11px] font-mono bg-[#18171b] border border-[#333138] text-zinc-200">
							{ m.Username }
							<button
								hx-delete={ "/admin/groups/" + g.ID + "/members/" + m.ID }
								aria-label={ "Keluarkan " + m.Username }
								class="px-1 text-zinc-500 hover:text-[#ff8080] cursor-pointer"
							>×</button>
						</span>
					}
				</div>
				<form hx-post={ "/admin/groups/" + g.ID + "/members" } class="mt-2 flex items-center gap-2">
					<select name="user_id" required aria-label={ "Tambah anggota ke " + g.Name } class={ adminSelect }>
						<option value="">Pilih pengguna…</option>
						for _, u := range users {
							if !g.HasMember(u.ID) {
								<option value={ u.ID }>{ u.Username }</option>
							}
						}
					</select>
					<button type="submit" class={ btnSmall }>+ Tambah</button>
				</form>
			}
		</div>
	</div>
}
