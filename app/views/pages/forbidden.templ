package pages

import (
	"dbplatform/app/domain"
	"dbplatform/app/views/layouts"
)

// Forbidden is the full-page response for a denied database action (HTTP 403).
templ Forbidden(user *domain.AuthLayoutUser, activeTab string, message string, csrfToken string) {
	@layouts.Dashboard("Akses Ditolak", user, "", activeTab, csrfToken) {
		<div class="max-w-xl mx-auto mt-16 bg-[#222126] border border-[#ff8080]/30 rounded-2xl p-8 text-center space-y-3">
			<h1 class="text-lg font-bold text-[#ff8080]">403 · Akses ditolak</h1>
			<p class="text-xs text-zinc-300 leading-relaxed">{ message }</p>
			<a href="/dashboard" class="inline-block mt-2 text-xs font-semibold text-[#ceafa3] hover:underline">Kembali ke Database Viewer</a>
		</div>
	}
}
