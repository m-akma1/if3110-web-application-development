package pages

import (
	"fmt"
	"dbplatform/app/domain"
	"dbplatform/app/views/layouts"
)

templ detailField(label string, value string) {
	<div>
		<dt class="text-[10px] font-bold text-zinc-500 uppercase tracking-wider">{ label }</dt>
		<dd class="mt-0.5 text-xs text-zinc-200 font-mono">{ value }</dd>
	</div>
}

// MigrationDetail shows one migration: what ran, who ran it, when, how long, and the outcome.
templ MigrationDetail(user *domain.AuthLayoutUser, v domain.MigrationDetailView, csrfToken string) {
	@layouts.Dashboard("Detail Migration", user, v.Migration.DatabaseID, "migration", csrfToken) {
		<div class="space-y-5 max-w-5xl">
			<a href={ templ.SafeURL(migrationPageURL(v.Migration.DatabaseID, "")) } class="text-xs font-semibold text-[#ceafa3] hover:underline">← Kembali ke Migration Editor</a>

			<div class="flex flex-wrap items-start justify-between gap-4">
				<div>
					<div class="flex items-center gap-3">
						<h1 class="text-2xl font-bold text-zinc-100">{ v.Migration.Name }</h1>
						@MigrationStatusBadge(v.Migration.Status)
					</div>
					<p class="text-zinc-400 mt-1 text-xs font-mono">{ v.Migration.ID }</p>
				</div>
				if v.CanEdit {
					if v.Migration.Status == "DRAFT" {
						<a href={ templ.SafeURL(migrationPageURL(v.Migration.DatabaseID, v.Migration.ID)) } class="px-4 py-1.5 rounded-lg text-xs font-bold bg-[#ceafa3] hover:bg-[#c09f93] text-[#121212] transition shadow-md">
							Buka di Editor
						</a>
					} else {
						<button
							type="button"
							hx-post={ fmt.Sprintf("/migration/%s/duplicate", v.Migration.ID) }
							hx-target="#migration-feedback"
							class="px-4 py-1.5 rounded-lg text-xs font-bold bg-[#252525] hover:bg-[#333] text-white transition"
						>
							Duplikat sebagai Draft Baru
						</button>
					}
				}
			</div>
			<div id="migration-feedback"></div>

			<dl class="grid grid-cols-2 md:grid-cols-4 gap-4 bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl p-5">
				@detailField("Database", v.Migration.DatabaseName)
				@detailField("Versi", v.Migration.VersionLabel())
				@detailField("Dibuat oleh", v.Migration.CreatedByName)
				@detailField("Dibuat pada", fmtTime(v.Migration.CreatedAt))
				@detailField("Dieksekusi oleh", v.Migration.ExecutedByName)
				@detailField("Dieksekusi pada", fmtTime(v.Migration.ExecutedAt))
				@detailField("Durasi", fmt.Sprintf("%d ms", v.Migration.DurationMs))
				@detailField("Status", v.Migration.Status)
			</dl>

			if v.Migration.Status == "FAILED" {
				<div class="space-y-2">
					<h3 class="text-xs font-bold text-[#ff8080] uppercase tracking-wider px-1">Error · seluruh script di-ROLLBACK</h3>
					<pre class="p-4 rounded-xl bg-[#ff8080]/10 border border-[#ff8080]/30 text-[#ff8080] text-xs font-mono whitespace-pre-wrap">{ v.Migration.Error }</pre>
				</div>
			}
			if v.Migration.Status == "SUCCESS" {
				<div class="p-3 rounded-lg bg-[#7dff95]/10 border border-[#7dff95]/30 text-[#7dff95] text-xs font-mono">
					✓ Seluruh statement berhasil dan di-COMMIT sebagai { v.Migration.VersionLabel() }.
				</div>
			}

			<div class="space-y-2">
				<h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider px-1">Script SQL</h3>
				<pre class="p-4 rounded-xl bg-[#121212] border border-[#2a2a2a] text-[#87d1ff] text-xs font-mono whitespace-pre-wrap overflow-x-auto">{ v.Migration.SQL }</pre>
			</div>
		</div>
	}
}
