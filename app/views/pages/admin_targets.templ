package pages

import (
	"dbplatform/app/domain"
	"fmt"
)

templ adminTargetsSection(ov domain.AdminOverview) {
	<div class="space-y-6">
		@adminCard("Daftarkan Database PostgreSQL", "Koneksi diuji saat disimpan; password disimpan terenkripsi") {
			<form method="post" hx-post="/admin/databases" class="p-4">
				@targetFields(domain.TargetItem{Port: 5432, SSLMode: "disable"}, true)
				<div class="mt-3 flex justify-end">
					<button type="submit" class={ btnPrimary }>+ Uji &amp; Simpan Koneksi</button>
				</div>
			</form>
		}

		@adminCard("Database Terdaftar", fmt.Sprintf("%d database", len(ov.Targets))) {
			if len(ov.Targets) == 0 {
				<p class="p-4 text-xs text-zinc-500">Belum ada database terdaftar.</p>
			} else {
				<div class="divide-y divide-app-border">
					for _, t := range ov.Targets {
						@targetRow(t)
					}
				</div>
			}
		}
	</div>
}

templ targetRow(t domain.TargetItem) {
	<div class="p-4 space-y-2">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div>
				<div class="text-sm font-bold text-white">{ t.Name }</div>
				<div class="text-[11px] font-mono text-zinc-400">
					{ fmt.Sprintf("%s@%s:%d/%s · sslmode=%s", t.Username, t.Host, t.Port, t.DBName, t.SSLMode) }
				</div>
			</div>
			<div class="flex items-center gap-2">
				@targetStatusBadge(t.Status)
				<button hx-post={ "/admin/databases/" + t.ID + "/test" } class={ btnSmall }>Uji Koneksi</button>
				<button
					hx-delete={ "/admin/databases/" + t.ID }
					hx-confirm={ "Hapus " + t.Name + " dari platform? Seluruh akses group ke database ini ikut dihapus. Database aslinya tidak diubah." }
					class={ btnDanger }
				>Hapus</button>
			</div>
		</div>
		if t.LastError != "" {
			<div class="text-[11px] text-sem-danger font-mono break-all">{ t.LastError }</div>
		}
		if t.LastCheckedAt != nil {
			<div class="text-[10px] text-zinc-500">Terakhir diuji { t.LastCheckedAt.Format("2006-01-02 15:04:05") }</div>
		}
		<details class="text-xs">
			<summary class="cursor-pointer text-zinc-400 hover:text-zinc-200">Ubah koneksi</summary>
			<form method="post" hx-post={ "/admin/databases/" + t.ID } class="mt-2">
				@targetFields(t, false)
				<div class="mt-3 flex justify-end">
					<button type="submit" class={ btnSmall }>Simpan &amp; Uji Ulang</button>
				</div>
			</form>
		</details>
	</div>
}

templ targetStatusBadge(status string) {
	switch status {
		case "CONNECTED":
			<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sem-success/15 text-sem-success border border-sem-success/30">CONNECTED</span>
		case "ERROR":
			<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sem-danger/15 text-sem-danger border border-sem-danger/30">ERROR</span>
		default:
			<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-app-active text-zinc-300">BELUM DIUJI</span>
	}
}

// targetFields renders the connection form fields. On edit, an empty password keeps the stored one.
templ targetFields(t domain.TargetItem, creating bool) {
	<div class="grid grid-cols-1 md:grid-cols-4 gap-3">
		<div>
			<label class={ adminLabel }>Nama tampilan</label>
			<input name="name" value={ t.Name } required minlength="2" maxlength="100" placeholder="Postgres Staging" class={ adminInput }/>
		</div>
		<div>
			<label class={ adminLabel }>Host</label>
			<input name="host" value={ t.Host } required placeholder="target-postgres" class={ adminInput }/>
		</div>
		<div>
			<label class={ adminLabel }>Port</label>
			<input name="port" type="number" min="1" max="65535" value={ fmt.Sprintf("%d", t.Port) } class={ adminInput }/>
		</div>
		<div>
			<label class={ adminLabel }>Nama database</label>
			<input name="db_name" value={ t.DBName } required maxlength="63" placeholder="app_db" class={ adminInput }/>
		</div>
		<div>
			<label class={ adminLabel }>Username</label>
			<input name="username" value={ t.Username } required maxlength="63" autocomplete="off" class={ adminInput }/>
		</div>
		<div>
			<label class={ adminLabel }>Password</label>
			if creating {
				<input name="password" type="password" required autocomplete="new-password" class={ adminInput }/>
			} else {
				<input name="password" type="password" autocomplete="new-password" placeholder="kosongkan = tidak diubah" class={ adminInput }/>
			}
		</div>
		<div>
			<label class={ adminLabel }>Mode SSL</label>
			<select name="ssl_mode" class={ adminInput }>
				for _, m := range []string{"disable", "require", "verify-full"} {
					<option value={ m } selected?={ t.SSLMode == m }>{ m }</option>
				}
			</select>
		</div>
		<div class="text-[10px] text-zinc-500 self-end">
			Gunakan role non-superuser. Kueri viewer selalu berjalan dalam transaksi read-only.
		</div>
	</div>
}
