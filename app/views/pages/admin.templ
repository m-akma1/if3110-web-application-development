package pages

import (
	"fmt"
	"dbplatform/app/domain"
	"dbplatform/app/internal/authn"
	"dbplatform/app/views/layouts"
)

templ Admin(user *authn.AuthLayoutUser, activeDBID string, instances []domain.DBInstance, users []domain.UserManagementItem, csrfToken string) {
	@layouts.Dashboard("Platform Admin", user, activeDBID, "admin", csrfToken) {
		<div class="space-y-6" x-data="{ activeTab: 'databases' }">
			<!-- Header -->
			<div>
				<h1 class="text-2xl font-bold text-white">Platform Administration</h1>
				<p class="text-slate-400 mt-1">Kelola koneksi target database, pengguna platform, dan izin akses.</p>
			</div>

			<!-- Tab Navigation -->
			<div class="flex gap-2 border-b border-slate-700/60 pb-3">
				<button 
					@click="activeTab = 'databases'"
					:class="activeTab === 'databases' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'"
					class="px-4 py-2 rounded-lg text-xs font-semibold transition"
				>
					Target Databases
				</button>
				<button 
					@click="activeTab = 'users'"
					:class="activeTab === 'users' ? 'bg-blue-600 text-white' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'"
					class="px-4 py-2 rounded-lg text-xs font-semibold transition"
				>
					Pengguna & Hak Akses
				</button>
			</div>

			<!-- TAB 1: Target Databases -->
			<div x-show="activeTab === 'databases'" class="space-y-6">
				<!-- Form Tambah DB Instance -->
				<div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6 space-y-4 shadow-xl">
					<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Daftarkan Instance Database Baru</h3>
					
					<form id="add-db-form" class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">Nama Tampilan</label>
							<input type="text" name="name" required placeholder="e.g. Postgres Staging" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">DBMS</label>
							<select name="dbms" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500">
								<option value="POSTGRESQL">PostgreSQL</option>
								<option value="MYSQL">MySQL</option>
								<option value="MARIADB">MariaDB</option>
							</select>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">Host / IP</label>
							<input type="text" name="host" required placeholder="localhost" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">Port</label>
							<input type="number" name="port" value="5432" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">Nama Database Target</label>
							<input type="text" name="db_name" required placeholder="app_db" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500"/>
						</div>
						<div class="flex items-end">
							<button 
								type="button"
								hx-post="/admin/db/add"
								hx-target="#admin-feedback"
								hx-include="#add-db-form"
								class="w-full py-2 px-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition"
							>
								Uji & Simpan Koneksi
							</button>
						</div>
					</form>
				</div>

				<div id="admin-feedback"></div>

				<!-- Tabel Daftar Database -->
				<div class="bg-slate-800/60 border border-slate-700/60 rounded-xl overflow-hidden shadow-xl">
					<table class="w-full text-left text-sm text-slate-300">
						<thead class="bg-slate-900/80 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-700">
							<tr>
								<th class="px-4 py-3 font-semibold">Nama Instance</th>
								<th class="px-4 py-3 font-semibold">DBMS</th>
								<th class="px-4 py-3 font-semibold">Host & Port</th>
								<th class="px-4 py-3 font-semibold">Database Target</th>
								<th class="px-4 py-3 font-semibold">Status</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-700/60">
							for _, db := range instances {
								<tr class="hover:bg-slate-700/30 transition">
									<td class="px-4 py-3 text-xs font-bold text-white">{ db.Name }</td>
									<td class="px-4 py-3 font-mono text-xs text-blue-400">{ db.DBMS }</td>
									<td class="px-4 py-3 font-mono text-xs">{ fmt.Sprintf("%s:%d", db.Host, db.Port) }</td>
									<td class="px-4 py-3 font-mono text-xs">{ db.DBName }</td>
									<td class="px-4 py-3 text-xs">
										if db.Status == "CONNECTED" {
											<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
												CONNECTED
											</span>
										} else {
											<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/30">
												ERROR
											</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- TAB 2: User Management -->
			<div x-show="activeTab === 'users'" class="space-y-6" x-cloak>
				<div class="bg-slate-800/60 border border-slate-700/60 rounded-xl overflow-hidden shadow-xl">
					<table class="w-full text-left text-sm text-slate-300">
						<thead class="bg-slate-900/80 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-700">
							<tr>
								<th class="px-4 py-3 font-semibold">ID</th>
								<th class="px-4 py-3 font-semibold">Username</th>
								<th class="px-4 py-3 font-semibold">Role</th>
								<th class="px-4 py-3 font-semibold">Akses DB</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-700/60">
							for _, u := range users {
								<tr class="hover:bg-slate-700/30 transition">
									<td class="px-4 py-3 font-mono text-xs">{ u.ID }</td>
									<td class="px-4 py-3 font-bold text-white text-xs">{ u.Username }</td>
									<td class="px-4 py-3 text-xs">
										if u.Role == "PLATFORM_ADMIN" {
											<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-500/20 text-blue-400 border border-blue-500/30">
												PLATFORM ADMIN
											</span>
										} else {
											<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-700 text-slate-300">
												USER
											</span>
										}
									</td>
									<td class="px-4 py-3 text-xs">{ fmt.Sprintf("%d Database Terhubung", u.AccessCount) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

templ AdminFeedback(success bool, message string) {
	if success {
		<div class="p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
			✓ { message }
		</div>
	} else {
		<div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-mono">
			✗ { message }
		</div>
	}
}