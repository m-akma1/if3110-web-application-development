package pages

import (
	"dbplatform/app/domain"
	"dbplatform/app/views/layouts"
	"fmt"
)

// Admin is the Platform Admin overview: users (with role change), groups, and invite codes.
// Platform Admin manages the platform; it is not a database access level.
templ Admin(
	user *domain.AuthLayoutUser,
	activeDBID string,
	users []domain.UserManagementItem,
	groups []domain.GroupItem,
	codes []domain.InviteCodeItem,
	csrfToken string,
) {
	@layouts.Dashboard("Platform Admin", user, activeDBID, "admin", csrfToken) {
		<div class="space-y-6" x-data="{ activeTab: 'users' }">
			<div>
				<h1 class="text-2xl font-bold text-white tracking-tight">Platform Administration</h1>
				<p class="text-zinc-400 mt-1 text-xs">
					Akses database diberikan per group, bukan per user. Setiap user selalu menjadi anggota group Public.
				</p>
			</div>

			<div class="flex gap-2 border-b border-[#333138] pb-3">
				@adminTabButton("users", fmt.Sprintf("Pengguna (%d)", len(users)))
				@adminTabButton("groups", fmt.Sprintf("Group (%d)", len(groups)))
				@adminTabButton("codes", fmt.Sprintf("Kode Undangan (%d)", len(codes)))
			</div>

			<div x-show="activeTab === 'users'">
				@AdminUsersTable(users, "", true)
			</div>

			<div x-show="activeTab === 'groups'" x-cloak>
				@adminCard("Daftar Group") {
					<table class="w-full text-left text-sm text-zinc-300">
						<thead class="bg-[#18171b] text-xs uppercase tracking-wider text-zinc-400 border-b border-[#333138]">
							<tr>
								<th class="px-4 py-3 font-semibold">Nama</th>
								<th class="px-4 py-3 font-semibold">Deskripsi</th>
								<th class="px-4 py-3 font-semibold text-right">Anggota</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[#333138]">
							for _, g := range groups {
								<tr>
									<td class="px-4 py-3 text-xs font-semibold text-zinc-100">
										{ g.Name }
										if g.IsSystem {
											<span class="ml-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#2c2a30] text-zinc-300">SISTEM</span>
										}
									</td>
									<td class="px-4 py-3 text-xs text-zinc-400">{ g.Description }</td>
									<td class="px-4 py-3 text-xs font-mono text-right">{ fmt.Sprintf("%d", g.MemberCount) }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>

			<div x-show="activeTab === 'codes'" x-cloak>
				@adminCard("Kode Undangan") {
					<table class="w-full text-left text-sm text-zinc-300">
						<thead class="bg-[#18171b] text-xs uppercase tracking-wider text-zinc-400 border-b border-[#333138]">
							<tr>
								<th class="px-4 py-3 font-semibold">Kode</th>
								<th class="px-4 py-3 font-semibold">Group Tujuan</th>
								<th class="px-4 py-3 font-semibold">Status</th>
								<th class="px-4 py-3 font-semibold">Dibuat</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[#333138]">
							if len(codes) == 0 {
								<tr><td colspan="4" class="px-4 py-8 text-center text-xs text-zinc-500">Belum ada kode undangan.</td></tr>
							}
							for _, c := range codes {
								<tr>
									<td class="px-4 py-3 text-xs font-mono font-bold text-[#ceafa3]">{ c.Code }</td>
									<td class="px-4 py-3 text-xs">{ c.GroupName }</td>
									<td class="px-4 py-3 text-xs">
										if c.IsActive {
											<span class="text-[#7dff95]">Aktif</span>
										} else {
											<span class="text-zinc-500">Nonaktif</span>
										}
									</td>
									<td class="px-4 py-3 text-xs text-zinc-400">{ c.CreatedAt.Format("2006-01-02 15:04") }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</div>
	}
}

templ adminTabButton(key string, label string) {
	<button
		type="button"
		@click={ "activeTab = '" + key + "'" }
		:class={ "activeTab === '" + key + "' ? 'bg-[#ceafa3] text-[#121212] font-bold' : 'text-zinc-400 hover:bg-[#252429] hover:text-zinc-200'" }
		class="px-4 py-2 rounded-xl text-xs transition cursor-pointer"
	>
		{ label }
	</button>
}

templ adminCard(title string) {
	<div class="bg-[#222126] border border-[#333138] rounded-2xl overflow-hidden shadow-xl">
		<div class="px-4 py-3 bg-[#18171b] border-b border-[#333138]">
			<span class="text-xs font-bold text-white uppercase tracking-wider">{ title }</span>
		</div>
		<div class="overflow-x-auto">
			{ children... }
		</div>
	</div>
}

// AdminUsersTable is also returned alone after a role change (HTMX swap).
templ AdminUsersTable(users []domain.UserManagementItem, feedbackMsg string, success bool) {
	<div id="admin-users-table" class="space-y-3">
		if feedbackMsg != "" {
			if success {
				<div class="p-3 rounded-xl bg-[#7dff95]/10 border border-[#7dff95]/30 text-[#7dff95] text-xs">{ feedbackMsg }</div>
			} else {
				<div class="p-3 rounded-xl bg-[#ff8080]/10 border border-[#ff8080]/30 text-[#ff8080] text-xs">{ feedbackMsg }</div>
			}
		}
		@adminCard("Pengguna Platform") {
			<table class="w-full text-left text-sm text-zinc-300">
				<thead class="bg-[#18171b] text-xs uppercase tracking-wider text-zinc-400 border-b border-[#333138]">
					<tr>
						<th class="px-4 py-3 font-semibold">Username &amp; Email</th>
						<th class="px-4 py-3 font-semibold">Group</th>
						<th class="px-4 py-3 font-semibold">Status</th>
						<th class="px-4 py-3 font-semibold">Role</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-[#333138]">
					for _, u := range users {
						<tr>
							<td class="px-4 py-3">
								<div class="text-xs font-semibold text-zinc-100">{ u.Username }</div>
								if u.Email != "" {
									<div class="text-[11px] text-zinc-500">{ u.Email }</div>
								}
							</td>
							<td class="px-4 py-3">
								<div class="flex flex-wrap gap-1">
									for _, g := range u.Groups {
										<span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-[#18171b] border border-[#333138] text-zinc-300">{ g.Name }</span>
									}
								</div>
							</td>
							<td class="px-4 py-3 text-xs">
								if u.IsActive {
									<span class="text-[#7dff95]">Aktif</span>
								} else {
									<span class="text-zinc-500">Nonaktif</span>
								}
							</td>
							<td class="px-4 py-3">
								<form hx-post="/admin/users/role" hx-target="#admin-users-table" hx-swap="outerHTML" class="flex items-center gap-2">
									<input type="hidden" name="user_id" value={ u.ID }/>
									<select name="role" class="bg-[#18171b] border border-[#333138] text-zinc-200 text-xs rounded-lg px-2 py-1">
										<option value="USER" selected?={ u.Role == "USER" }>USER</option>
										<option value="PLATFORM_ADMIN" selected?={ u.Role == "PLATFORM_ADMIN" }>PLATFORM_ADMIN</option>
									</select>
									<button type="submit" class="px-2.5 py-1 rounded-lg bg-[#ceafa3] hover:bg-[#c2a195] text-[#121212] text-[11px] font-bold cursor-pointer">Simpan</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}
