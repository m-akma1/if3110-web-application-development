package pages

import (
	"dbplatform/app/domain"
	"dbplatform/app/internal/authn"
	"dbplatform/app/views/layouts"
	"fmt"
)

templ Admin(
	user *authn.AuthLayoutUser,
	activeDBID string,
	instances []domain.DBInstance,
	codes []domain.TeamInviteCodeItem,
	users []domain.UserManagementItem,
	csrfToken string,
) {
	@layouts.Dashboard("Platform Admin", user, activeDBID, "admin", csrfToken) {
		<div class="space-y-6" x-data="{ activeTab: 'databases' }">
			<!-- Header -->
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<h1 class="text-2xl font-bold text-white tracking-tight">Platform Administration</h1>
					<p class="text-slate-400 mt-1 text-xs">
						Kelola kode undangan database, koneksi target database, serta berikan hak akses kepada masing-masing pengguna.
					</p>
				</div>
				<div class="px-3 py-1.5 rounded-lg bg-blue-500/10 border border-blue-500/20 text-xs text-blue-400 flex items-center gap-2">
					<span class="font-semibold">Owner Passcode:</span>
					<code class="font-mono font-bold text-white">OWNER-SECRET-2026</code>
				</div>
			</div>

			<!-- Tab Navigation -->
			<div class="flex gap-2 border-b border-slate-700/80 pb-3">
				<button
					type="button"
					@click="activeTab = 'databases'"
					:class="activeTab === 'databases' ? 'bg-blue-600 text-white font-semibold shadow' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'"
					class="px-4 py-2 rounded-lg text-xs transition cursor-pointer"
				>
					Kode Akses &amp; Target Databases
				</button>
				<button
					type="button"
					@click="activeTab = 'users'"
					:class="activeTab === 'users' ? 'bg-blue-600 text-white font-semibold shadow' : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'"
					class="px-4 py-2 rounded-lg text-xs transition cursor-pointer flex items-center gap-2"
				>
					<span>Pengguna &amp; Pemberian Hak Akses</span>
					<span class="px-1.5 py-0.5 rounded bg-slate-800 text-slate-200 text-[10px] font-mono">
						{ fmt.Sprintf("%d User", len(users)) }
					</span>
				</button>
			</div>

			<!-- TAB 1: Kode Database & Target Databases -->
			<div x-show="activeTab === 'databases'" class="space-y-6">
				@AdminCodesSection(codes, instances, "")

				<!-- Form Tambah DB Instance Card -->
				<div class="bg-slate-800/80 border border-slate-700/60 rounded-xl p-6 space-y-4 shadow-xl">
					<h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider">Daftarkan Instance Database Baru</h3>

					<form
						id="add-db-form"
						hx-post="/admin/db/add"
						hx-target="#admin-feedback"
						hx-swap="innerHTML"
						class="grid grid-cols-1 md:grid-cols-3 gap-4"
					>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">Nama Tampilan</label>
							<input
								type="text"
								name="name"
								required
								placeholder="e.g. Postgres Staging"
								class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:outline-none"
							/>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">DBMS</label>
							<select
								name="dbms"
								class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:outline-none"
							>
								<option value="POSTGRESQL">PostgreSQL</option>
								<option value="MYSQL">MySQL</option>
								<option value="MARIADB">MariaDB</option>
							</select>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">Host / IP</label>
							<input
								type="text"
								name="host"
								required
								placeholder="localhost"
								class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:outline-none"
							/>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">Port</label>
							<input
								type="number"
								name="port"
								value="5432"
								class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:outline-none"
							/>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-300 mb-1">Nama Database Target</label>
							<input
								type="text"
								name="db_name"
								required
								placeholder="app_db"
								class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:outline-none"
							/>
						</div>
						<div class="flex items-end">
							<button
								type="submit"
								class="w-full py-2 px-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition shadow-md cursor-pointer"
							>
								+ Uji &amp; Simpan Koneksi
							</button>
						</div>
					</form>
				</div>

				<div id="admin-feedback"></div>

				<!-- Tabel Daftar Database -->
				<div class="bg-slate-800/80 border border-slate-700/60 rounded-xl overflow-hidden shadow-xl">
					<div class="px-4 py-3 bg-slate-900/90 border-b border-slate-700 flex items-center justify-between">
						<span class="text-xs font-bold text-white uppercase tracking-wider">Daftar Instance Database Terdaftar</span>
						<span class="text-[10px] text-slate-400">{ fmt.Sprintf("%d Database", len(instances)) }</span>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-left text-sm text-slate-300">
							<thead class="bg-slate-900/60 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-700">
								<tr>
									<th class="px-4 py-3 font-semibold">ID / Kode DB</th>
									<th class="px-4 py-3 font-semibold">Nama Instance</th>
									<th class="px-4 py-3 font-semibold">Kode Tim Default</th>
									<th class="px-4 py-3 font-semibold">DBMS</th>
									<th class="px-4 py-3 font-semibold">Host &amp; Port</th>
									<th class="px-4 py-3 font-semibold">Database Target</th>
									<th class="px-4 py-3 font-semibold">Status</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-slate-700/60">
								for _, db := range instances {
									<tr class="hover:bg-slate-700/30 transition">
										<td class="px-4 py-3 font-mono text-xs text-slate-400">{ db.ID }</td>
										<td class="px-4 py-3 text-xs font-bold text-white">{ db.Name }</td>
										<td class="px-4 py-3">
											<span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-blue-500/10 text-blue-400 border border-blue-500/20">
												{ db.InviteCode }
											</span>
										</td>
										<td class="px-4 py-3 font-mono text-xs text-blue-400">{ db.DBMS }</td>
										<td class="px-4 py-3 font-mono text-xs">{ fmt.Sprintf("%s:%d", db.Host, db.Port) }</td>
										<td class="px-4 py-3 font-mono text-xs">{ db.DBName }</td>
										<td class="px-4 py-3 text-xs">
											if db.Status == "CONNECTED" {
												<span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
													CONNECTED
												</span>
											} else {
												<span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-red-500/10 text-red-400 border border-red-500/30">
													ERROR
												</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<!-- TAB 2: User Management & Pemberian Hak Akses -->
			<div x-show="activeTab === 'users'" x-cloak class="space-y-6">
				@AdminUsersTable(users, "")
			</div>
		</div>
	}
}

templ AdminCodesSection(codes []domain.TeamInviteCodeItem, instances []domain.DBInstance, feedbackMsg string) {
	<div id="admin-codes-container" class="bg-slate-800/80 border border-slate-700/60 rounded-xl p-6 space-y-5 shadow-xl">
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<h3 class="text-xs font-bold text-white uppercase tracking-wider">Kode Undangan Database &amp; Tim (Sign Up Codes)</h3>
				<p class="text-xs text-slate-400 mt-0.5">
					Bagikan kode ini kepada anggota tim saat melakukan Sign Up agar mereka otomatis mendapatkan akses database sesuai grupnya.
				</p>
			</div>
		</div>

		if feedbackMsg != "" {
			<div class="p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-medium">
				✓ { feedbackMsg }
			</div>
		}

		<!-- Daftar Kartu Kode Undangan -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			for _, item := range codes {
				<div class="p-4 rounded-xl bg-slate-900/90 border border-slate-700 flex flex-col justify-between space-y-3" x-data="{ copied: false }">
					<div class="flex items-start justify-between gap-2">
						<div>
							<span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold">Grup: { item.GroupName }</span>
							<div class="text-base font-mono font-bold text-blue-400 mt-0.5">{ item.Code }</div>
						</div>
						<button
							type="button"
							@click={ "navigator.clipboard.writeText('" + item.Code + "'); copied = true; setTimeout(() => copied = false, 1500)" }
							class="px-2.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 border border-slate-600 text-[10px] font-semibold text-slate-200 transition cursor-pointer"
						>
							<span x-show="!copied">Salin Kode</span>
							<span x-show="copied" x-cloak class="text-emerald-400">Tersalin!</span>
						</button>
					</div>
					<div class="pt-2 border-t border-slate-800 flex items-center justify-between text-xs">
						<span class="text-slate-400 truncate">DB: <strong class="text-slate-200">{ item.DatabaseName }</strong></span>
						if item.DefaultAccess == "VIEW_EDIT" {
							<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
								VIEW_EDIT
							</span>
						} else {
							<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
								VIEW_ONLY
							</span>
						}
					</div>
				</div>
			}
		</div>

		<!-- Form Buat Kode Undangan Baru -->
		<form
			hx-post="/admin/codes/generate"
			hx-target="#admin-codes-container"
			hx-swap="outerHTML"
			class="pt-4 border-t border-slate-700/60 grid grid-cols-1 md:grid-cols-4 gap-3 items-end"
		>
			<div>
				<label class="block text-xs font-medium text-slate-300 mb-1">Kode Undangan Baru</label>
				<input
					type="text"
					name="code"
					required
					placeholder="e.g. TEAM-DEVOPS"
					class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs font-mono text-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:outline-none uppercase"
				/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-300 mb-1">Nama Grup / Tim</label>
				<input
					type="text"
					name="group_name"
					required
					placeholder="e.g. DevOps-Engineers"
					class="w-full px-3 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs text-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 focus:outline-none"
				/>
			</div>
			<div>
				<label class="block text-xs font-medium text-slate-300 mb-1">Database &amp; Hak Akses Default</label>
				<div class="flex gap-2">
					<select
						name="database_id"
						class="w-1/2 px-2.5 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs text-white focus:outline-none"
					>
						for _, inst := range instances {
							<option value={ inst.ID }>{ inst.Name }</option>
						}
					</select>
					<select
						name="default_access"
						class="w-1/2 px-2.5 py-2 bg-slate-900/90 border border-slate-700 rounded-lg text-xs text-white focus:outline-none"
					>
						<option value="VIEW_ONLY">VIEW_ONLY</option>
						<option value="VIEW_EDIT">VIEW_EDIT</option>
					</select>
				</div>
			</div>
			<div>
				<button
					type="submit"
					class="w-full py-2 px-4 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition cursor-pointer"
				>
					+ Tambah Kode Tim
				</button>
			</div>
		</form>
	</div>
}

templ AdminUsersTable(users []domain.UserManagementItem, feedbackMsg string) {
	<div id="admin-users-container" class="space-y-4">
		if feedbackMsg != "" {
			<div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-medium">
				✓ { feedbackMsg }
			</div>
		}

		<div class="bg-slate-800/80 border border-slate-700/60 rounded-xl overflow-hidden shadow-xl">
			<div class="px-4 py-3 bg-slate-900/90 border-b border-slate-700 flex items-center justify-between">
				<span class="text-xs font-bold text-white uppercase tracking-wider">Manajemen Hak Akses Pengguna per Database</span>
				<span class="text-[10px] text-slate-400">Perubahan langsung diterapkan ke sesi pengguna</span>
			</div>
			<div class="overflow-x-auto">
				<table class="w-full text-left text-xs text-slate-300">
					<thead class="bg-slate-900/60 uppercase tracking-wider text-slate-400 border-b border-slate-700">
						<tr>
							<th class="px-4 py-3 font-semibold">Pengguna (Username &amp; Email)</th>
							<th class="px-4 py-3 font-semibold">Peran Sistem (Role)</th>
							<th class="px-4 py-3 font-semibold">Akses PostgreSQL Utama (db-1)</th>
							<th class="px-4 py-3 font-semibold">Akses MySQL Production (db-2)</th>
							<th class="px-4 py-3 font-semibold text-right">Aksi</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-700/60">
						for _, u := range users {
							<tr class="hover:bg-slate-700/30 transition">
								<td class="px-4 py-3">
									<div class="font-bold text-white text-xs">{ u.Username }</div>
									<div class="font-mono text-[11px] text-slate-400">{ u.Email }</div>
									<div class="font-mono text-[10px] text-slate-500 mt-0.5">ID: { u.ID }</div>
								</td>
								<td class="px-4 py-3" colspan="4">
									<form
										hx-post="/admin/users/access"
										hx-target="#admin-users-container"
										hx-swap="outerHTML"
										class="grid grid-cols-1 md:grid-cols-4 gap-3 items-center"
									>
										<input type="hidden" name="user_id" value={ u.ID }/>
										<!-- Role Selector -->
										<div>
											<select
												name="role"
												class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white focus:border-blue-500 focus:outline-none"
											>
												<option value="USER" selected?={ u.Role == "USER" }>USER (Anggota Tim)</option>
												<option value="PLATFORM_ADMIN" selected?={ u.Role == "PLATFORM_ADMIN" }>PLATFORM_ADMIN (Owner)</option>
											</select>
										</div>

										<!-- Grant DB 1 -->
										<div>
											<select
												name="access_db_1"
												class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs font-mono text-white focus:border-blue-500 focus:outline-none"
											>
												<option value="VIEW_EDIT" selected?={ getGrantLevel(u.Grants, "db-1") == "VIEW_EDIT" }>VIEW_EDIT (Baca + Migrasi)</option>
												<option value="VIEW_ONLY" selected?={ getGrantLevel(u.Grants, "db-1") == "VIEW_ONLY" }>VIEW_ONLY (Hanya Baca)</option>
												<option value="NONE" selected?={ getGrantLevel(u.Grants, "db-1") == "NONE" }>NONE (Tanpa Akses)</option>
											</select>
										</div>

										<!-- Grant DB 2 -->
										<div>
											<select
												name="access_db_2"
												class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded-lg text-xs font-mono text-white focus:border-blue-500 focus:outline-none"
											>
												<option value="VIEW_EDIT" selected?={ getGrantLevel(u.Grants, "db-2") == "VIEW_EDIT" }>VIEW_EDIT (Baca + Migrasi)</option>
												<option value="VIEW_ONLY" selected?={ getGrantLevel(u.Grants, "db-2") == "VIEW_ONLY" }>VIEW_ONLY (Hanya Baca)</option>
												<option value="NONE" selected?={ getGrantLevel(u.Grants, "db-2") == "NONE" }>NONE (Tanpa Akses)</option>
											</select>
										</div>

										<!-- Submit Button -->
										<div class="flex justify-end">
											<button
												type="submit"
												class="px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition cursor-pointer"
											>
												Simpan Hak Akses
											</button>
										</div>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

func getGrantLevel(grants []domain.UserAccessGrant, dbID string) string {
	for _, g := range grants {
		if g.DatabaseID == dbID {
			return g.EffectiveAccess
		}
	}
	return "VIEW_ONLY"
}

templ AdminFeedback(success bool, message string) {
	if success {
		<div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
			✓ { message }
		</div>
	} else {
		<div class="p-3.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-mono">
			✗ { message }
		</div>
	}
}
