package pages

import (
	"fmt"
	"dbplatform/app/domain"
	"dbplatform/app/internal/authn"
	"dbplatform/app/views/layouts"
)

templ Admin(user *authn.AuthLayoutUser, activeDBID string, instances []domain.DBInstance, users []domain.UserManagementItem, csrfToken string) {
	@layouts.Dashboard("Platform Admin", user, activeDBID, "admin", csrfToken) {
		<div class="space-y-6" x-data="{ activeTab: 'databases' }">
			<!-- Header -->
			<div>
				<h1 class="text-2xl font-bold text-zinc-100">Platform Administration</h1>
				<p class="text-zinc-400 mt-1 text-xs">Kelola koneksi target database, pengguna platform, dan izin akses.</p>
			</div>

			<!-- Tab Navigation -->
			<div class="flex gap-2 border-b border-[#333138] pb-3">
				<button 
					@click="activeTab = 'databases'"
					:class="activeTab === 'databases' ? 'bg-[#ceafa3] text-[#121212] font-bold' : 'text-zinc-400 hover:bg-[#252429] hover:text-zinc-200'"
					class="px-4 py-2 rounded-xl text-xs transition"
				>
					Target Databases
				</button>
				<button 
					@click="activeTab = 'users'"
					:class="activeTab === 'users' ? 'bg-[#ceafa3] text-[#121212] font-bold' : 'text-zinc-400 hover:bg-[#252429] hover:text-zinc-200'"
					class="px-4 py-2 rounded-xl text-xs transition"
				>
					Pengguna & Hak Akses
				</button>
			</div>

			<!-- TAB 1: Target Databases -->
			<div x-show="activeTab === 'databases'" class="space-y-6">
				<!-- Form Tambah DB Instance Card -->
				<div class="bg-[#222126] border border-[#333138] rounded-2xl p-6 space-y-4 shadow-xl">
					<h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider">Daftarkan Instance Database Baru</h3>
					
					<form id="add-db-form" class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<div>
							<label class="block text-xs font-medium text-zinc-300 mb-1">Nama Tampilan</label>
							<input type="text" name="name" required placeholder="e.g. Postgres Staging" class="w-full px-3 py-2 bg-[#18171b] border border-[#333138] rounded-xl text-xs text-white focus:ring-2 focus:ring-[#ceafa3]/50 focus:outline-none"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-zinc-300 mb-1">DBMS</label>
							<select name="dbms" class="w-full px-3 py-2 bg-[#18171b] border border-[#333138] rounded-xl text-xs text-white focus:ring-2 focus:ring-[#ceafa3]/50 focus:outline-none">
								<option value="POSTGRESQL">PostgreSQL</option>
								<option value="MYSQL">MySQL</option>
								<option value="MARIADB">MariaDB</option>
							</select>
						</div>
						<div>
							<label class="block text-xs font-medium text-zinc-300 mb-1">Host / IP</label>
							<input type="text" name="host" required placeholder="localhost" class="w-full px-3 py-2 bg-[#18171b] border border-[#333138] rounded-xl text-xs text-white focus:ring-2 focus:ring-[#ceafa3]/50 focus:outline-none"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-zinc-300 mb-1">Port</label>
							<input type="number" name="port" value="5432" class="w-full px-3 py-2 bg-[#18171b] border border-[#333138] rounded-xl text-xs text-white focus:ring-2 focus:ring-[#ceafa3]/50 focus:outline-none"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-zinc-300 mb-1">Nama Database Target</label>
							<input type="text" name="db_name" required placeholder="app_db" class="w-full px-3 py-2 bg-[#18171b] border border-[#333138] rounded-xl text-xs text-white focus:ring-2 focus:ring-[#ceafa3]/50 focus:outline-none"/>
						</div>
						<div class="flex items-end">
							<button 
								type="button"
								hx-post="/admin/db/add"
								hx-target="#admin-feedback"
								hx-include="#add-db-form"
								class="w-full py-2.5 px-4 rounded-xl bg-[#ceafa3] hover:bg-[#c2a195] text-[#121212] text-xs font-bold transition shadow-md"
							>
								+ Uji & Simpan Koneksi
							</button>
						</div>
					</form>
				</div>

				<div id="admin-feedback"></div>

				<!-- Tabel Daftar Database -->
				<div class="bg-[#222126] border border-[#333138] rounded-2xl overflow-hidden shadow-xl">
					<table class="w-full text-left text-sm text-zinc-300">
						<thead class="bg-[#18171b] text-xs uppercase tracking-wider text-zinc-400 border-b border-[#333138]">
							<tr>
								<th class="px-4 py-3 font-semibold">Nama Instance</th>
								<th class="px-4 py-3 font-semibold">DBMS</th>
								<th class="px-4 py-3 font-semibold">Host & Port</th>
								<th class="px-4 py-3 font-semibold">Database Target</th>
								<th class="px-4 py-3 font-semibold">Status</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[#333138]">
							for _, db := range instances {
								<tr class="hover:bg-[#2c2a30]/50 transition">
									<td class="px-4 py-3 text-xs font-bold text-white">{ db.Name }</td>
									<td class="px-4 py-3 font-mono text-xs text-[#87d1ff]">{ db.DBMS }</td>
									<td class="px-4 py-3 font-mono text-xs">{ fmt.Sprintf("%s:%d", db.Host, db.Port) }</td>
									<td class="px-4 py-3 font-mono text-xs">{ db.DBName }</td>
									<td class="px-4 py-3 text-xs">
										if db.Status == "CONNECTED" {
											<span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-[#7dff95]/15 text-[#7dff95] border border-[#7dff95]/30">
												CONNECTED
											</span>
										} else {
											<span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-[#ff8080]/15 text-[#ff8080] border border-[#ff8080]/30">
												ERROR
											</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- TAB 2: User Management -->
			<div x-show="activeTab === 'users'" class="space-y-6" x-cloak>
				<div class="bg-[#222126] border border-[#333138] rounded-2xl overflow-hidden shadow-xl">
					<table class="w-full text-left text-sm text-zinc-300">
						<thead class="bg-[#18171b] text-xs uppercase tracking-wider text-zinc-400 border-b border-[#333138]">
							<tr>
								<th class="px-4 py-3 font-semibold">ID</th>
								<th class="px-4 py-3 font-semibold">Username</th>
								<th class="px-4 py-3 font-semibold">Role</th>
								<th class="px-4 py-3 font-semibold">Akses DB</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[#333138]">
							for _, u := range users {
								<tr class="hover:bg-[#2c2a30]/50 transition">
									<td class="px-4 py-3 font-mono text-xs">{ u.ID }</td>
									<td class="px-4 py-3 font-bold text-white text-xs">{ u.Username }</td>
									<td class="px-4 py-3 text-xs">
										if u.Role == "PLATFORM_ADMIN" {
											<span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-[#ceafa3]/20 text-[#ceafa3] border border-[#ceafa3]/30">
												PLATFORM ADMIN
											</span>
										} else {
											<span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-[#18171b] text-zinc-300 border border-[#333138]">
												USER
											</span>
										}
									</td>
									<td class="px-4 py-3 text-xs">{ fmt.Sprintf("%d Database Terhubung", u.AccessCount) }</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

templ AdminFeedback(success bool, message string) {
	if success {
		<div class="p-3.5 rounded-xl bg-[#7dff95]/10 border border-[#7dff95]/30 text-[#7dff95] text-xs font-mono">
			✓ { message }
		</div>
	} else {
		<div class="p-3.5 rounded-xl bg-[#ff8080]/10 border border-[#ff8080]/30 text-[#ff8080] text-xs font-mono">
			✗ { message }
		</div>
	}
}