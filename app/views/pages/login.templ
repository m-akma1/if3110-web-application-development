package pages

import "dbplatform/app/views/layouts"

templ Login(csrfToken string, errorMessage string) {
	@layouts.Base("Login", csrfToken) {
		<div class="min-h-screen flex items-center justify-center bg-[#121212] p-4">
			<div class="w-full max-w-md bg-[#1c1b1e] border border-[#333138] rounded-2xl p-8 shadow-2xl space-y-6" x-data="{ showPassword: false }">
				<div class="text-center space-y-2">
					<h1 class="text-2xl font-bold text-zinc-100">DB Manager</h1>
					<p class="text-xs text-zinc-400">Masuk ke platform manajemen database</p>
				</div>

				<div id="login-error">
					if errorMessage != "" {
						@LoginError(errorMessage)
					}
				</div>

				<form 
					id="login-form" 
					hx-post="/login" 
					hx-target="#login-error"
					hx-swap="innerHTML"
					class="space-y-4"
				>
					<input type="hidden" name="csrf_token" value={ csrfToken }/>

					<div>
						<label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-1">Username</label>
						<input 
							type="text" 
							name="username" 
							required 
							autofocus
							@keydown.enter.prevent="document.getElementById('login-btn').click()"
							placeholder="Masukkan username" 
							class="w-full px-3.5 py-2.5 bg-[#18171b] border border-[#333138] rounded-xl text-xs text-zinc-100 focus:outline-none focus:ring-2 focus:ring-[#ceafa3]/50 transition"
						/>
					</div>

					<div>
						<label class="block text-xs font-semibold text-zinc-300 uppercase tracking-wider mb-1">Password</label>
						<div class="relative flex items-center">
							<input 
								:type="showPassword ? 'text' : 'password'" 
								name="password" 
								required 
								@keydown.enter.prevent="document.getElementById('login-btn').click()"
								placeholder="••••••••" 
								class="w-full px-3.5 py-2.5 pr-10 bg-[#18171b] border border-[#333138] rounded-xl text-xs text-zinc-100 focus:outline-none focus:ring-2 focus:ring-[#ceafa3]/50 transition"
							/>
							<button 
								type="button" 
								@click="showPassword = !showPassword"
								class="absolute right-3 text-zinc-400 hover:text-[#ceafa3] transition"
								tabindex="-1"
							>
								<!-- Ikon Mata Terbuka -->
								<svg x-show="!showPassword" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
								</svg>
								<!-- Ikon Mata Tertutup -->
								<svg x-show="showPassword" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" x-cloak>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858-5.908a10.02 10.02 0 012.122-.363c4.478 0 8.268 2.943 9.542 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21M3 3l18 18"></path>
								</svg>
							</button>
						</div>
					</div>

					<button 
						id="login-btn"
						type="submit" 
						class="w-full py-2.5 px-4 rounded-xl bg-[#ceafa3] hover:bg-[#c2a195] text-[#121212] text-xs font-bold transition shadow-md mt-2"
					>
						Masuk
					</button>
				</form>
			</div>
		</div>
	}
}

templ LoginError(msg string) {
	<div class="p-3 rounded-xl bg-[#ff8080]/10 border border-[#ff8080]/30 text-[#ff8080] text-xs font-medium">
		{ msg }
	</div>
}