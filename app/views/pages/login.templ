package pages

templ Login(csrfToken string, errorMessage string) {
	@LoginPage(csrfToken, AuthFormState{GeneralError: errorMessage})
}

// Partial Component untuk respon error login via HTMX
templ LoginError(message string) {
	<div class="p-3 rounded-xl bg-[#ff8080]/10 border border-[#ff8080]/30 text-[#ff8080] text-xs font-medium">
		{ message }
	</div>
}
