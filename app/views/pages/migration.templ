package pages

import (
	"fmt"
	"dbplatform/app/domain"
	"dbplatform/app/internal/authn"
	"dbplatform/app/views/layouts"
)

templ Migration(user *authn.AuthLayoutUser, activeDBID string, histories []domain.MigrationHistory, csrfToken string) {
	@layouts.Dashboard("Migration Editor", user, activeDBID, "migration", csrfToken) {
		<div class="space-y-6" x-data="{ query: 'CREATE TABLE example (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(255) NOT NULL\n);' }">
			<div>
				<h1 class="text-2xl font-bold text-white">Migration Editor</h1>
				<p class="text-slate-400 mt-1">Tulis dan eksekusi skrip DDL/SQL untuk memperbarui skema database terhubung.</p>
			</div>

			<div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6 space-y-4 shadow-xl">
				<form id="migration-form">
					<div class="flex justify-between items-center mb-4">
						<label class="text-xs font-bold text-slate-400 uppercase tracking-wider">
							Skrip SQL Migrasi
						</label>
						<div class="flex gap-2">
							<button 
								type="button"
								@click="query = ''"
								class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-400 hover:bg-slate-700 transition"
							>
								Bersihkan
							</button>
							<button 
								type="button"
								hx-post="/migration/dry-run"
								hx-target="#migration-feedback"
								hx-include="#migration-form"
								class="px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-700 hover:bg-slate-600 text-white transition"
							>
								Simulasi (Dry Run)
							</button>
							<button 
								type="button"
								hx-post="/migration/apply"
								hx-target="#migration-feedback"
								hx-include="#migration-form"
								class="px-4 py-1.5 rounded-lg text-xs font-semibold bg-blue-600 hover:bg-blue-500 text-white transition shadow-md"
							>
								Terapkan Migrasi
							</button>
						</div>
					</div>

					<div class="relative">
						<textarea 
							id="sql_script"
							name="sql_script" 
							x-model="query"
							rows="8"
							class="w-full p-4 bg-slate-900 border border-slate-700 rounded-lg font-mono text-xs text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500 leading-relaxed resize-y"
							placeholder="-- Tulis perintah SQL di sini..."
						></textarea>
					</div>
				</form>

				<div id="migration-feedback"></div>
			</div>

			<div class="space-y-3">
				<h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider px-1">Riwayat Eksekusi Migrasi</h3>
				<div class="bg-slate-800/60 border border-slate-700/60 rounded-xl overflow-hidden shadow-xl">
					<table class="w-full text-left text-sm text-slate-300">
						<thead class="bg-slate-900/80 text-xs uppercase tracking-wider text-slate-400 border-b border-slate-700">
							<tr>
								<th class="px-4 py-3 font-semibold">ID</th>
								<th class="px-4 py-3 font-semibold">Nama File / Skrip</th>
								<th class="px-4 py-3 font-semibold">Waktu Eksekusi</th>
								<th class="px-4 py-3 font-semibold">Oleh</th>
								<th class="px-4 py-3 font-semibold">Durasi</th>
								<th class="px-4 py-3 font-semibold">Status</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-700/60">
							if len(histories) > 0 {
								for _, h := range histories {
									<tr class="hover:bg-slate-700/30 transition">
										<td class="px-4 py-3 font-mono text-xs">{ h.ID }</td>
										<td class="px-4 py-3 font-mono text-xs font-semibold text-slate-200">{ h.Filename }</td>
										<td class="px-4 py-3 text-xs">{ h.ExecutedAt.Format("2006-01-02 15:04:05") }</td>
										<td class="px-4 py-3 text-xs">{ h.ExecutedBy }</td>
										<td class="px-4 py-3 font-mono text-xs">{ fmt.Sprintf("%d ms", h.ExecutionMs) }</td>
										<td class="px-4 py-3 text-xs">
											if h.Status == "SUCCESS" {
												<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
													SUCCESS
												</span>
											} else {
												<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/20 text-red-400 border border-red-500/30">
													FAILED
												</span>
											}
										</td>
									</tr>
								}
							} else {
								<tr>
									<td colspan="6" class="px-4 py-8 text-center text-slate-500 text-xs">
										Belum ada riwayat migrasi pada database ini.
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	}
}

templ MigrationFeedback(success bool, message string) {
	if success {
		<div class="p-3 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
			✓ { message }
		</div>
	} else {
		<div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-mono">
			✗ { message }
		</div>
	}
}