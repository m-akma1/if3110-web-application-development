package pages

import "dbplatform/app/views/layouts"

// Struct untuk menampung pesan error & nilai input sebelumnya
type AuthFormState struct {
	Email         string
	InviteCode    string
	EmailError    string
	PasswordError string
	CodeError     string
	GeneralError  string
}

// ==========================================
// 1. HALAMAN & FORM LOGIN
// ==========================================

templ LoginPage(csrfToken string, state AuthFormState) {
	@layouts.Auth("Masuk", csrfToken) {
		@LoginForm(state)
	}
}

templ LoginForm(state AuthFormState) {
	<div class="space-y-7">
		<!-- Header -->
		<div class="space-y-3">
			<div class="text-[#ceafa3]">
				<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9"></path>
				</svg>
			</div>
			<h1 class="text-2xl font-bold text-white tracking-tight">
				Welcome back
			</h1>
			<p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
				Access your databases, queries, and projects anytime, anywhere - and keep everything flowing in one place.
			</p>
		</div>

		if state.GeneralError != "" {
			<div class="p-3 rounded-lg bg-[#ff8080]/10 border border-[#ff8080]/30 text-xs font-medium text-[#ff8080]">
				{ state.GeneralError }
			</div>
		}

		<!-- Form Login -->
		<form hx-post="/auth/login" hx-target="#auth-form-container" hx-swap="innerHTML" class="space-y-5">
			<!-- Input Email + Error di Samping Label -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label for="email" class="block text-xs font-semibold text-zinc-200">
						Your email
					</label>
					if state.EmailError != "" {
						<span class="text-xs font-medium text-[#ff8080] flex items-center gap-1 animate-pulse">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.EmailError }
						</span>
					}
				</div>
				<input
					type="email"
					id="email"
					name="email"
					value={ state.Email }
					placeholder="nama@email.com"
					required
					autofocus
					class={ "w-full px-3.5 py-2.5 text-sm rounded-lg border bg-[#18171b] text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
						templ.KV("border-[#ff8080] focus:border-[#ff8080] focus:ring-[#ff8080]/30", state.EmailError != ""),
						templ.KV("border-[#333138] focus:border-[#ceafa3] focus:ring-[#ceafa3]/50", state.EmailError == "") }
				/>
			</div>

			<!-- Input Password + Error di Samping Label -->
			<div class="space-y-1.5" x-data="{ show: false }">
				<div class="flex items-center justify-between gap-2">
					<label for="password" class="block text-xs font-semibold text-zinc-200">
						Password
					</label>
					if state.PasswordError != "" {
						<span class="text-xs font-medium text-[#ff8080] flex items-center gap-1 animate-pulse">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.PasswordError }
						</span>
					}
				</div>
				<div class="relative">
					<input
						:type="show ? 'text' : 'password'"
						id="password"
						name="password"
						placeholder="••••••••••"
						required
						class={ "w-full pl-3.5 pr-10 py-2.5 text-sm rounded-lg border bg-[#18171b] text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
							templ.KV("border-[#ff8080] focus:border-[#ff8080] focus:ring-[#ff8080]/30", state.PasswordError != ""),
							templ.KV("border-[#333138] focus:border-[#ceafa3] focus:ring-[#ceafa3]/50", state.PasswordError == "") }
					/>
					<button
						type="button"
						@click="show = !show"
						tabindex="-1"
						class="absolute inset-y-0 right-0 pr-3 flex items-center text-zinc-400 hover:text-zinc-200 focus:outline-none cursor-pointer"
					>
						<svg x-show="!show" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
						<svg x-show="show" x-cloak class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
						</svg>
					</button>
				</div>

				<!-- Tombol Lupa Password (tidak melakukan aksi karena belum disetup di backend) -->
				<div class="flex justify-end pt-1">
					<button
						type="button"
						class="text-xs font-medium text-[#ceafa3] hover:text-[#c2a195] hover:underline focus:outline-none transition cursor-pointer"
					>
						Forgot password?
					</button>
				</div>
			</div>

			<!-- Tombol Submit -->
			<div class="pt-1">
				<button
					type="submit"
					class="w-full py-2.5 px-4 bg-[#ceafa3] hover:bg-[#c2a195] text-[#121212] text-xs sm:text-sm font-semibold rounded-lg shadow-lg shadow-[#ceafa3]/20 transition cursor-pointer"
				>
					Get Started
				</button>
			</div>
		</form>

		<!-- Footer Link ke Sign Up -->
		<p class="text-center text-xs text-zinc-400 pt-2">
			Don't have an account?
			<a
				href="/auth/signup"
				hx-get="/auth/signup"
				hx-target="#auth-form-container"
				hx-push-url="true"
				class="font-semibold text-[#ceafa3] hover:text-[#c2a195] hover:underline ml-1"
			>
				Sign up
			</a>
		</p>
	</div>
}

// ==========================================
// 2. HALAMAN & FORM SIGN UP
// ==========================================

templ SignupPage(csrfToken string, state AuthFormState) {
	@layouts.Auth("Daftar Akun", csrfToken) {
		@SignupForm(state)
	}
}

templ SignupForm(state AuthFormState) {
	<div class="space-y-6" x-data="{ show: false }">
		<!-- Header -->
		<div class="space-y-2.5">
			<div class="text-[#ceafa3]">
				<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9"></path>
				</svg>
			</div>
			<h1 class="text-2xl font-bold text-white tracking-tight">
				Create an account
			</h1>
			<p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
				Masukkan kode tim dari Platform Admin untuk bergabung dan mulai melihat database.
			</p>
		</div>

		if state.GeneralError != "" {
			<div class="p-3 rounded-lg bg-[#ff8080]/10 border border-[#ff8080]/30 text-xs font-medium text-[#ff8080]">
				{ state.GeneralError }
			</div>
		}

		<!-- Form Sign Up -->
		<form hx-post="/auth/signup" hx-target="#auth-form-container" hx-swap="innerHTML" class="space-y-4">
			<!-- Input Email + Error di Samping Label -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label for="signup-email" class="block text-xs font-semibold text-zinc-200">
						Your email
					</label>
					if state.EmailError != "" {
						<span class="text-xs font-medium text-[#ff8080] flex items-center gap-1">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.EmailError }
						</span>
					}
				</div>
				<input
					type="email"
					id="signup-email"
					name="email"
					value={ state.Email }
					placeholder="nama@email.com"
					required
					class={ "w-full px-3.5 py-2.5 text-sm rounded-lg border bg-[#18171b] text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
						templ.KV("border-[#ff8080] focus:border-[#ff8080] focus:ring-[#ff8080]/30", state.EmailError != ""),
						templ.KV("border-[#333138] focus:border-[#ceafa3] focus:ring-[#ceafa3]/50", state.EmailError == "") }
				/>
			</div>

			<!-- Input Password + Error di Samping Label -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label for="signup-password" class="block text-xs font-semibold text-zinc-200">
						Password
					</label>
					if state.PasswordError != "" {
						<span class="text-xs font-medium text-[#ff8080] flex items-center gap-1">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.PasswordError }
						</span>
					}
				</div>
				<div class="relative">
					<input
						:type="show ? 'text' : 'password'"
						id="signup-password"
						name="password"
						placeholder="Minimal 8 karakter"
						required
						class={ "w-full pl-3.5 pr-10 py-2.5 text-sm rounded-lg border bg-[#18171b] text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
							templ.KV("border-[#ff8080] focus:border-[#ff8080] focus:ring-[#ff8080]/30", state.PasswordError != ""),
							templ.KV("border-[#333138] focus:border-[#ceafa3] focus:ring-[#ceafa3]/50", state.PasswordError == "") }
					/>
					<button
						type="button"
						@click="show = !show"
						tabindex="-1"
						class="absolute inset-y-0 right-0 pr-3 flex items-center text-zinc-400 hover:text-zinc-200 focus:outline-none cursor-pointer"
					>
						<svg x-show="!show" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
						<svg x-show="show" x-cloak class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
						</svg>
					</button>
				</div>
			</div>

			<!-- Input Kode Undangan Tim -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label
						for="signup-invite-code"
						class="block text-xs font-semibold text-zinc-200"
					>
						Team Invite Code
					</label>
					if state.CodeError != "" {
						<span class="text-xs font-medium text-[#ff8080] flex items-center gap-1">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.CodeError }
						</span>
					}
				</div>
				<input
					type="text"
					id="signup-invite-code"
					name="invite_code"
					value={ state.InviteCode }
					placeholder="Masukkan kode tim"
					required
					class={ "w-full px-3.5 py-2.5 text-sm font-mono rounded-lg border bg-[#18171b] text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
						templ.KV("border-[#ff8080] focus:border-[#ff8080] focus:ring-[#ff8080]/30", state.CodeError != ""),
						templ.KV("border-[#333138] focus:border-[#ceafa3] focus:ring-[#ceafa3]/50", state.CodeError == "") }
				/>
			</div>

			<!-- Tombol Submit -->
			<div class="pt-1">
				<button
					type="submit"
					class="w-full py-2.5 px-4 bg-[#ceafa3] hover:bg-[#c2a195] text-[#121212] text-xs sm:text-sm font-semibold rounded-lg shadow-lg shadow-[#ceafa3]/20 transition cursor-pointer"
				>
					Create Account
				</button>
			</div>
		</form>

		<!-- Footer Link ke Login -->
		<p class="text-center text-xs text-zinc-400 pt-1">
			Already have an account?
			<a
				href="/auth/login"
				hx-get="/auth/login"
				hx-target="#auth-form-container"
				hx-push-url="true"
				class="font-semibold text-[#ceafa3] hover:text-[#c2a195] hover:underline ml-1"
			>
				Log in
			</a>
		</p>
	</div>
}
