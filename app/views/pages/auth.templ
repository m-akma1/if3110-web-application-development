package pages

import "dbplatform/app/views/layouts"

// Struct untuk menampung pesan error & nilai input sebelumnya
type AuthFormState struct {
	Identifier      string // login: username atau email
	Username        string // signup
	Email           string // signup (opsional)
	InviteCode      string // signup (opsional)
	IdentifierError string
	UsernameError   string
	EmailError      string
	PasswordError   string
	CodeError       string
	GeneralError    string
}

templ LoginPage(csrfToken string, state AuthFormState) {
	@layouts.Auth("Masuk", csrfToken) {
		@LoginForm(state)
	}
}

templ LoginForm(state AuthFormState) {
	<div class="space-y-7">
		<!-- Header -->
		<div class="space-y-3">
			<div class="text-brand-primary">
				<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9"></path>
				</svg>
			</div>
			<h1 class="text-2xl font-bold text-white tracking-tight">
				Welcome back
			</h1>
			<p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
				Access your databases, queries, and projects anytime, anywhere - and keep everything flowing in one place.
			</p>
		</div>

		if state.GeneralError != "" {
			<div class="p-3 rounded-lg bg-sem-danger/10 border border-sem-danger/30 text-xs font-medium text-sem-danger">
				{ state.GeneralError }
			</div>
		}

		<!-- Form Login -->
		<form method="post" action="/login" hx-post="/login" hx-target="#auth-form-container" hx-swap="innerHTML" class="space-y-5">
			<!-- Input Username atau Email + Error di Samping Label -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label for="identifier" class="block text-xs font-semibold text-zinc-200">
						Username or email
					</label>
					if state.IdentifierError != "" {
						<span class="text-xs font-medium text-sem-danger flex items-center gap-1 animate-pulse">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.IdentifierError }
						</span>
					}
				</div>
				<input
					type="text"
					id="identifier"
					name="identifier"
					value={ state.Identifier }
					placeholder="username atau nama@email.com"
					autocomplete="username"
					autocapitalize="none"
					spellcheck="false"
					required
					autofocus
					class={ "w-full px-3.5 py-2.5 text-sm rounded-lg border bg-app-input text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
						templ.KV("border-sem-danger focus:border-sem-danger focus:ring-sem-danger/30", state.IdentifierError != ""),
						templ.KV("border-app-border focus:border-brand-primary focus:ring-brand-primary/50", state.IdentifierError == "") }
				/>
			</div>

			<!-- Input Password + Error di Samping Label -->
			<div class="space-y-1.5" x-data="{ show: false }">
				<div class="flex items-center justify-between gap-2">
					<label for="password" class="block text-xs font-semibold text-zinc-200">
						Password
					</label>
					if state.PasswordError != "" {
						<span class="text-xs font-medium text-sem-danger flex items-center gap-1 animate-pulse">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.PasswordError }
						</span>
					}
				</div>
				<div class="relative">
					<input
						:type="show ? 'text' : 'password'"
						id="password"
						name="password"
						placeholder="••••••••••"
						autocomplete="current-password"
						required
						class={ "w-full pl-3.5 pr-10 py-2.5 text-sm rounded-lg border bg-app-input text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
							templ.KV("border-sem-danger focus:border-sem-danger focus:ring-sem-danger/30", state.PasswordError != ""),
							templ.KV("border-app-border focus:border-brand-primary focus:ring-brand-primary/50", state.PasswordError == "") }
					/>
					<button
						type="button"
						@click="show = !show"
						tabindex="-1"
						class="absolute inset-y-0 right-0 pr-3 flex items-center text-zinc-400 hover:text-zinc-200 focus:outline-none cursor-pointer"
					>
						<svg x-show="!show" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
						<svg x-show="show" x-cloak class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
						</svg>
					</button>
				</div>

				<!-- Password direset oleh Platform Admin (Admin → Users), tidak ada reset mandiri -->
				<p class="pt-1 text-right text-[11px] text-zinc-500">
					Lupa password? Minta Platform Admin untuk meresetnya.
				</p>
			</div>

			<!-- Tombol Submit -->
			<div class="pt-1">
				<button
					type="submit"
					class="w-full py-2.5 px-4 bg-brand-primary hover:bg-brand-primary-hover text-app-bg text-xs sm:text-sm font-semibold rounded-lg shadow-lg shadow-brand-primary/20 transition cursor-pointer"
				>
					Get Started
				</button>
			</div>
		</form>

		<!-- Footer Link ke Sign Up -->
		<p class="text-center text-xs text-zinc-400 pt-2">
			Don't have an account?
			<a
				href="/signup"
				hx-get="/signup"
				hx-target="#auth-form-container"
				hx-push-url="true"
				class="font-semibold text-brand-primary hover:text-brand-primary-hover hover:underline ml-1"
			>
				Sign up
			</a>
		</p>
	</div>
}

templ SignupPage(csrfToken string, state AuthFormState) {
	@layouts.Auth("Daftar Akun", csrfToken) {
		@SignupForm(state)
	}
}

templ SignupForm(state AuthFormState) {
	<div class="space-y-6" x-data="{ show: false }">
		<!-- Header -->
		<div class="space-y-2.5">
			<div class="text-brand-primary">
				<svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9"></path>
				</svg>
			</div>
			<h1 class="text-2xl font-bold text-white tracking-tight">
				Create an account
			</h1>
			<p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
				Daftar dengan username Anda. Kode tim bersifat opsional. Tanpa kode, Anda tetap dapat masuk dan Platform Admin dapat memberi akses nanti.
			</p>
		</div>

		if state.GeneralError != "" {
			<div class="p-3 rounded-lg bg-sem-danger/10 border border-sem-danger/30 text-xs font-medium text-sem-danger">
				{ state.GeneralError }
			</div>
		}

		<!-- Form Sign Up -->
		<form method="post" action="/signup" hx-post="/signup" hx-target="#auth-form-container" hx-swap="innerHTML" class="space-y-4">
			<!-- Input Username + Error di Samping Label -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label for="signup-username" class="block text-xs font-semibold text-zinc-200">
						Username
					</label>
					if state.UsernameError != "" {
						<span class="text-xs font-medium text-sem-danger flex items-center gap-1">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.UsernameError }
						</span>
					}
				</div>
				<input
					type="text"
					id="signup-username"
					name="username"
					value={ state.Username }
					placeholder="contoh: budi.santoso"
					autocomplete="username"
					autocapitalize="none"
					spellcheck="false"
					minlength="3"
					maxlength="32"
					required
					autofocus
					class={ "w-full px-3.5 py-2.5 text-sm rounded-lg border bg-app-input text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
						templ.KV("border-sem-danger focus:border-sem-danger focus:ring-sem-danger/30", state.UsernameError != ""),
						templ.KV("border-app-border focus:border-brand-primary focus:ring-brand-primary/50", state.UsernameError == "") }
				/>
			</div>

			<!-- Input Email + Error di Samping Label -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label for="signup-email" class="block text-xs font-semibold text-zinc-200">
						Email <span class="font-normal text-zinc-500">(opsional)</span>
					</label>
					if state.EmailError != "" {
						<span class="text-xs font-medium text-sem-danger flex items-center gap-1">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.EmailError }
						</span>
					}
				</div>
				<input
					type="email"
					id="signup-email"
					name="email"
					value={ state.Email }
					placeholder="nama@email.com"
					autocomplete="email"
					class={ "w-full px-3.5 py-2.5 text-sm rounded-lg border bg-app-input text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
						templ.KV("border-sem-danger focus:border-sem-danger focus:ring-sem-danger/30", state.EmailError != ""),
						templ.KV("border-app-border focus:border-brand-primary focus:ring-brand-primary/50", state.EmailError == "") }
				/>
			</div>

			<!-- Input Password + Error di Samping Label -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label for="signup-password" class="block text-xs font-semibold text-zinc-200">
						Password
					</label>
					if state.PasswordError != "" {
						<span class="text-xs font-medium text-sem-danger flex items-center gap-1">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.PasswordError }
						</span>
					}
				</div>
				<div class="relative">
					<input
						:type="show ? 'text' : 'password'"
						id="signup-password"
						name="password"
						placeholder="Minimal 8 karakter"
						autocomplete="new-password"
						required
						class={ "w-full pl-3.5 pr-10 py-2.5 text-sm rounded-lg border bg-app-input text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
							templ.KV("border-sem-danger focus:border-sem-danger focus:ring-sem-danger/30", state.PasswordError != ""),
							templ.KV("border-app-border focus:border-brand-primary focus:ring-brand-primary/50", state.PasswordError == "") }
					/>
					<button
						type="button"
						@click="show = !show"
						tabindex="-1"
						class="absolute inset-y-0 right-0 pr-3 flex items-center text-zinc-400 hover:text-zinc-200 focus:outline-none cursor-pointer"
					>
						<svg x-show="!show" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
						<svg x-show="show" x-cloak class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
						</svg>
					</button>
				</div>
			</div>

			<!-- Input Kode Undangan Tim (opsional) -->
			<div class="space-y-1.5">
				<div class="flex items-center justify-between gap-2">
					<label
						for="signup-invite-code"
						class="block text-xs font-semibold text-zinc-200"
					>
						Team Invite Code <span class="font-normal text-zinc-500">(opsional)</span>
					</label>
					if state.CodeError != "" {
						<span class="text-xs font-medium text-sem-danger flex items-center gap-1">
							<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							{ state.CodeError }
						</span>
					}
				</div>
				<input
					type="text"
					id="signup-invite-code"
					name="invite_code"
					value={ state.InviteCode }
					placeholder="Kode Tim dari Platform Admin"
					class={ "w-full px-3.5 py-2.5 text-sm font-mono rounded-lg border bg-app-input text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition",
						templ.KV("border-sem-danger focus:border-sem-danger focus:ring-sem-danger/30", state.CodeError != ""),
						templ.KV("border-app-border focus:border-brand-primary focus:ring-brand-primary/50", state.CodeError == "") }
				/>
			</div>

			<!-- Tombol Submit -->
			<div class="pt-1">
				<button
					type="submit"
					class="w-full py-2.5 px-4 bg-brand-primary hover:bg-brand-primary-hover text-app-bg text-xs sm:text-sm font-semibold rounded-lg shadow-lg shadow-brand-primary/20 transition cursor-pointer"
				>
					Create Account
				</button>
			</div>
		</form>

		<!-- Footer Link ke Login -->
		<p class="text-center text-xs text-zinc-400 pt-1">
			Already have an account?
			<a
				href="/login"
				hx-get="/login"
				hx-target="#auth-form-container"
				hx-push-url="true"
				class="font-semibold text-brand-primary hover:text-brand-primary-hover hover:underline ml-1"
			>
				Log in
			</a>
		</p>
	</div>
}
