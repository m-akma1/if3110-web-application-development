package views

templ Hello() {
    <!DOCTYPE html>
    <html lang="id">
    <head>
        <meta charset="UTF-8"/>
        <title>GOTTH Test</title>
        <link href="/static/css/style.css" rel="stylesheet"/>
        <script src="/static/js/htmx.min.js"></script>
        <script defer src="/static/js/alpine.min.js"></script>
    </head>
    <body class="bg-slate-900 text-white min-h-screen flex flex-col items-center justify-center p-6">
        <div class="max-w-md w-full bg-slate-800 p-6 rounded-xl shadow-lg border border-slate-700 space-y-4">
            <h1 class="text-2xl font-bold text-blue-400">Environment Ready!</h1>
            <p class="text-slate-300">GOTTH Stack berhasil terhubung dengan rapi.</p>
            
            <!-- Test Alpine.js -->
            <div x-data="{ open: false }" class="pt-2">
                <button @click="open = !open" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 rounded-lg font-medium text-sm transition">
                    Test Alpine.js Toggle
                </button>
                <div x-show="open" class="mt-2 p-3 bg-slate-700/50 rounded-lg border border-slate-600 text-sm">
                    Alpine.js berjalan normal!
                </div>
            </div>

            <!-- Test HTMX -->
            <div class="pt-2 border-t border-slate-700">
                <button hx-get="/api/ping" hx-target="#ping-result" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 rounded-lg font-medium text-sm transition">
                    Test HTMX Ping
                </button>
                <div id="ping-result" class="mt-2 text-sm text-emerald-400 font-mono"></div>
            </div>
        </div>
    </body>
    </html>
}

templ PingResult() {
    <span>Pong dari Backend Go!</span>
}