package components

// ErrorState explains why something could not be loaded and offers a retry.
// With retryTarget the retry is an htmx request that replaces retryTarget (outerHTML);
// without it, retryURL is a normal link. An empty retryURL hides the button.
templ ErrorState(title, message, retryURL, retryTarget string) {
	<div class="max-w-xl mx-auto my-10 bg-[#222126] border border-[#ff8080]/30 rounded-2xl p-8 text-center space-y-3" role="alert">
		<div class="text-[#ff8080] flex justify-center">
			<svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m0 3.75h.008M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"></path></svg>
		</div>
		<h2 class="text-lg font-bold text-white">{ title }</h2>
		<p class="text-xs text-zinc-300 leading-relaxed break-words font-mono">{ message }</p>
		if retryURL != "" {
			if retryTarget != "" {
				<button
					type="button"
					hx-get={ retryURL }
					hx-target={ retryTarget }
					hx-swap="outerHTML"
					class="mt-2 px-4 py-2 rounded-lg bg-[#ceafa3] hover:bg-[#c2a195] text-[#121212] text-xs font-semibold transition cursor-pointer"
				>
					Coba lagi
				</button>
			} else {
				<a
					href={ templ.SafeURL(retryURL) }
					class="inline-block mt-2 px-4 py-2 rounded-lg bg-[#ceafa3] hover:bg-[#c2a195] text-[#121212] text-xs font-semibold transition"
				>
					Coba lagi
				</a>
			}
		}
	</div>
}
