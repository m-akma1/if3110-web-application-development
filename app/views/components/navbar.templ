package components

import "dbplatform/app/internal/authn"

templ Navbar(user *authn.AuthLayoutUser, activeDBID string) {
    <header class="h-16 w-full bg-slate-900/80 border-b border-slate-800 px-6 flex items-center justify-between shrink-0">
        <!-- Selector Database Target -->
        <div class="flex items-center gap-3">
            <span class="text-xs font-semibold text-cyan-400 uppercase tracking-wider">Database:</span>
            if user != nil && len(user.Databases) > 0 {
                <select 
                    name="db_id" 
                    hx-get="/dashboard/select-db" 
                    hx-target="body"
                    class="bg-slate-950 border border-slate-800 text-slate-200 text-xs font-mono rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-cyan-500/50"
                >
                    for _, db := range user.Databases {
                        <option value={ db.DatabaseID } selected?={ db.DatabaseID == activeDBID }>
                            { db.DatabaseName } ({ db.DBMS }) - { db.EffectiveAccess }
                        </option>
                    }
                </select>
            } else {
                <span class="text-xs text-amber-400 font-mono bg-amber-500/10 px-2.5 py-1 rounded-md border border-amber-500/20">
                    Tidak ada akses DB
                </span>
            }
        </div>

        <!-- Nama User & Badge Role (Tanpa Avatar / Foto Profil) -->
        <div class="flex items-center gap-2.5">
            if user != nil {
                if user.IsPlatformAdmin {
                    <span class="text-[10px] font-bold tracking-wider uppercase bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 px-2 py-0.5 rounded">
                        Admin
                    </span>
                }
                <span class="text-xs font-medium text-slate-200">{ user.Username }</span>
            } else {
                <span class="text-xs font-medium text-slate-400">Guest</span>
            }
        </div>
    </header>
}