package components

import "dbplatform/app/domain"

// accessLabel shows an access level in words.
func accessLabel(level string) string {
    switch level {
    case "VIEW_EDIT":
        return "View + Edit"
    case "VIEW_ONLY":
        return "View Only"
    default:
        return "Tanpa akses"
    }
}

templ Navbar(user *domain.AuthLayoutUser, activeDBID string) {
    <header class="h-16 w-full border-b border-[#333138] px-6 flex items-center justify-between shrink-0 bg-[#1c1b1e]">
        <div class="flex items-center gap-3">
            <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Database:</span>
            if user != nil && len(user.Databases) > 0 {
                <select 
                    name="db_id" 
                    hx-get="/dashboard/select-db" 
                    hx-target="body"
                    class="bg-[#18171b] border border-[#333138] text-zinc-200 text-xs font-mono rounded-xl px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-[#ceafa3]/50"
                >
                    for _, db := range user.Databases {
                        <option value={ db.DatabaseID } selected?={ db.DatabaseID == activeDBID }>
                            { db.DatabaseName } - { accessLabel(db.EffectiveAccess) }
                        </option>
                    }
                </select>
            } else {
                <span class="text-xs text-[#ffbc5e] font-mono bg-[#ffbc5e]/10 px-2.5 py-1 rounded-md border border-[#ffbc5e]/20">
                    Belum ada akses database
                </span>
            }
        </div>

        <div class="flex items-center gap-2.5">
            if user != nil {
                if user.IsPlatformAdmin {
                    <span class="text-[10px] font-bold tracking-wider uppercase bg-[#ceafa3] text-[#121212] px-2.5 py-1 rounded-lg">
                        ADMIN
                    </span>
                }
                <span class="text-xs font-semibold text-zinc-200">{ user.Username }</span>
            } else {
                <span class="text-xs font-medium text-zinc-400">Guest</span>
            }
        </div>
    </header>
}