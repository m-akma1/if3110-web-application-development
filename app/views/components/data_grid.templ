package components

import (
	"dbplatform/app/domain"
	"fmt"
)

func resolveSchemaName(s string) string {
	if s == "" {
		return "public"
	}
	return s
}

templ DataGrid(data domain.TableDataResult) {
	<div id="data-grid-container" class="space-y-4" x-data="{ activeView: 'data' }">
		if data.QueryError != "" {
			<div class="p-3.5 rounded-xl bg-[#ff8080]/10 border border-[#ff8080]/30 text-[#ff8080] text-xs font-medium flex items-center gap-2">
				<svg class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
				</svg>
				<span>{ data.QueryError }</span>
			</div>
		}

		if data.ExecutedQuery != "" && data.QueryError == "" {
			<div class="p-3 rounded-xl bg-[#7dff95]/10 border border-[#7dff95]/30 text-[#7dff95] text-xs flex items-center justify-between gap-2">
				<span>Query Read-Only berhasil dieksekusi: <code class="font-mono text-white">{ data.ExecutedQuery }</code></span>
				<span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-[#7dff95]/20">Read-Only Tx</span>
			</div>
		}

		if data.Truncated && data.QueryError == "" {
			<div class="p-3 rounded-xl bg-[#ffbc5e]/10 border border-[#ffbc5e]/30 text-[#ffbc5e] text-xs">
				Hasil dipotong: hanya { fmt.Sprintf("%d", len(data.Rows)) } baris pertama yang ditampilkan. Tambahkan LIMIT atau filter WHERE untuk mempersempit hasil.
			</div>
		}

		<!-- Header Tabel & Tab Switcher (Data Viewer vs Schema Viewer) -->
		<div class="flex flex-wrap items-center justify-between gap-3">
			<div class="flex items-center gap-2.5">
				<h2 class="text-lg font-bold text-white flex items-center gap-1.5">
					<span class="text-zinc-400 font-mono text-sm">{ resolveSchemaName(data.SchemaName) }.</span>
					<span class="text-[#ceafa3] font-mono">{ data.TableName }</span>
				</h2>
				<span class="text-xs text-zinc-400 bg-[#1a1a1a] px-2.5 py-1 rounded-lg border border-[#2a2a2a]">
					{ fmt.Sprintf("%d Baris", data.TotalRows) }
				</span>
			</div>

			<!-- Tombol Tab: Data Tabel & Schema Viewer -->
			<div class="inline-flex rounded-lg bg-[#121212] p-1 border border-[#2a2a2a]">
				<button
					type="button"
					@click="activeView = 'data'"
					:class="activeView === 'data' ? 'bg-[#ceafa3] text-[#121212] shadow' : 'text-zinc-400 hover:text-zinc-200'"
					class="px-3 py-1.5 rounded-md text-xs font-semibold transition cursor-pointer"
				>
					Data Tabel
				</button>
				<button
					type="button"
					@click="activeView = 'schema'"
					:class="activeView === 'schema' ? 'bg-[#ceafa3] text-[#121212] shadow' : 'text-zinc-400 hover:text-zinc-200'"
					class="px-3 py-1.5 rounded-md text-xs font-semibold transition cursor-pointer flex items-center gap-1.5"
				>
					<span>Schema Viewer</span>
					<span class="px-1.5 py-0.2 rounded text-[10px] bg-[#1a1a1a] text-zinc-300">
						{ fmt.Sprintf("%d Kolom", len(data.ColumnsMeta)) }
					</span>
				</button>
			</div>
		</div>

		<!-- TAB 1: DATA VIEWER -->
		<div x-show="activeView === 'data'" class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl overflow-hidden shadow-xl">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm text-zinc-300">
					<thead class="bg-[#121212] text-xs uppercase tracking-wider text-zinc-400 border-b border-[#2a2a2a]">
						<tr>
							for _, col := range data.Columns {
								<th class="px-4 py-3 font-semibold">{ col }</th>
							}
						</tr>
					</thead>
					<tbody class="divide-y divide-[#2a2a2a]">
						if len(data.Rows) > 0 {
							for _, row := range data.Rows {
								<tr class="hover:bg-[#252525]/50 transition">
									for _, val := range row {
										<td class="px-4 py-3 whitespace-nowrap font-mono text-xs">{ val }</td>
									}
								</tr>
							}
						} else {
							<tr>
								<td colspan={ fmt.Sprintf("%d", len(data.Columns)) } class="px-4 py-8 text-center text-zinc-500">
									Tabel ini tidak memiliki data.
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<div class="p-4 border-t border-[#2a2a2a] flex items-center justify-between text-xs text-zinc-400">
				<span>Halaman { fmt.Sprintf("%d dari %d", data.CurrentPage, data.TotalPages) }</span>
				<div class="flex gap-2">
					<button
						disabled?={ data.CurrentPage <= 1 }
						hx-get={ fmt.Sprintf("/dashboard/table?name=%s&page=%d", data.TableName, data.CurrentPage-1) }
						hx-target="#data-grid-container"
						hx-swap="outerHTML"
						class="px-3 py-1.5 rounded bg-[#252525] hover:bg-[#333] disabled:opacity-40 text-white transition"
					>
						Sebelumnya
					</button>
					<button
						disabled?={ data.CurrentPage >= data.TotalPages }
						hx-get={ fmt.Sprintf("/dashboard/table?name=%s&page=%d", data.TableName, data.CurrentPage+1) }
						hx-target="#data-grid-container"
						hx-swap="outerHTML"
						class="px-3 py-1.5 rounded bg-[#252525] hover:bg-[#333] disabled:opacity-40 text-white transition"
					>
						Selanjutnya
					</button>
				</div>
			</div>
		</div>

		<!-- TAB 2: SCHEMA VIEWER (Columns, Constraints, Indexes) -->
		<div x-show="activeView === 'schema'" x-cloak class="space-y-4">
			<!-- 1. Struktur Kolom -->
			<div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl overflow-hidden shadow-xl">
				<div class="px-4 py-3 bg-[#121212] border-b border-[#2a2a2a] flex items-center justify-between">
					<span class="text-xs font-bold text-white uppercase tracking-wider">Daftar Kolom (Columns)</span>
					<span class="text-[10px] font-mono text-zinc-400">Schema: { resolveSchemaName(data.SchemaName) }</span>
				</div>
				<div class="overflow-x-auto">
					<table class="w-full text-left text-xs text-zinc-300">
						<thead class="bg-[#121212] uppercase tracking-wider text-zinc-400 border-b border-[#2a2a2a]">
							<tr>
								<th class="px-4 py-2.5 font-semibold">Nama Kolom</th>
								<th class="px-4 py-2.5 font-semibold">Tipe Data</th>
								<th class="px-4 py-2.5 font-semibold">Nullable</th>
								<th class="px-4 py-2.5 font-semibold">Default</th>
								<th class="px-4 py-2.5 font-semibold">Atribut</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-[#2a2a2a]">
							if len(data.ColumnsMeta) > 0 {
								for _, colMeta := range data.ColumnsMeta {
									<tr class="hover:bg-[#252525]/50 transition">
										<td class="px-4 py-2.5 font-mono font-semibold text-white">{ colMeta.Name }</td>
										<td class="px-4 py-2.5 font-mono text-[#87d1ff]">{ colMeta.DataType }</td>
										<td class="px-4 py-2.5">
											if colMeta.IsNullable {
												<span class="px-2 py-0.5 rounded bg-[#252525] text-zinc-300 text-[10px] font-mono">NULL</span>
											} else {
												<span class="px-2 py-0.5 rounded bg-[#ffbc5e]/10 border border-[#ffbc5e]/20 text-[#ffbc5e] text-[10px] font-mono">NOT NULL</span>
											}
										</td>
										<td class="px-4 py-2.5 font-mono text-zinc-400">
											if colMeta.DefaultValue != "" {
												{ colMeta.DefaultValue }
											} else {
												<span>-</span>
											}
										</td>
										<td class="px-4 py-2.5">
											if colMeta.IsPK {
												<span class="px-2 py-0.5 rounded bg-[#ceafa3]/20 border border-[#ceafa3]/30 text-[#ceafa3] text-[10px] font-bold">PRIMARY KEY</span>
											} else {
												<span class="text-zinc-500">-</span>
											}
										</td>
									</tr>
								}
							} else {
								<tr>
									<td colspan="5" class="px-4 py-6 text-center text-zinc-500">
										Informasi kolom belum tersedia untuk tabel ini.
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>

			<!-- 2. Constraints & Indexes Grid -->
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
				<!-- Constraints -->
				<div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl overflow-hidden shadow-xl">
					<div class="px-4 py-3 bg-[#121212] border-b border-[#2a2a2a] flex items-center justify-between">
						<span class="text-xs font-bold text-white uppercase tracking-wider">Constraints</span>
						<span class="text-[10px] text-zinc-400">{ fmt.Sprintf("%d Constraint", len(data.Constraints)) }</span>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs text-zinc-300">
							<thead class="bg-[#121212] uppercase tracking-wider text-zinc-400 border-b border-[#2a2a2a]">
								<tr>
									<th class="px-4 py-2.5 font-semibold">Nama</th>
									<th class="px-4 py-2.5 font-semibold">Tipe</th>
									<th class="px-4 py-2.5 font-semibold">Definisi</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-[#2a2a2a]">
								if len(data.Constraints) > 0 {
									for _, cst := range data.Constraints {
										<tr class="hover:bg-[#252525]/50 transition">
											<td class="px-4 py-2.5 font-mono text-white">{ cst.Name }</td>
											<td class="px-4 py-2.5">
												<span class="px-2 py-0.5 rounded bg-[#ceafa3]/10 border border-[#ceafa3]/20 text-[#ceafa3] text-[10px] font-semibold">
													{ cst.Type }
												</span>
											</td>
											<td class="px-4 py-2.5 font-mono text-zinc-400">{ cst.Definition }</td>
										</tr>
									}
								} else {
									<tr>
										<td colspan="3" class="px-4 py-5 text-center text-zinc-500">Tidak ada constraint terdaftar.</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

				<!-- Indexes -->
				<div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl overflow-hidden shadow-xl">
					<div class="px-4 py-3 bg-[#121212] border-b border-[#2a2a2a] flex items-center justify-between">
						<span class="text-xs font-bold text-white uppercase tracking-wider">Indexes</span>
						<span class="text-[10px] text-zinc-400">{ fmt.Sprintf("%d Index", len(data.Indexes)) }</span>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full text-left text-xs text-zinc-300">
							<thead class="bg-[#121212] uppercase tracking-wider text-zinc-400 border-b border-[#2a2a2a]">
								<tr>
									<th class="px-4 py-2.5 font-semibold">Nama Index</th>
									<th class="px-4 py-2.5 font-semibold">Kolom</th>
									<th class="px-4 py-2.5 font-semibold">Tipe</th>
									<th class="px-4 py-2.5 font-semibold">Sifat</th>
								</tr>
							</thead>
							<tbody class="divide-y divide-[#2a2a2a]">
								if len(data.Indexes) > 0 {
									for _, idx := range data.Indexes {
										<tr class="hover:bg-[#252525]/50 transition">
											<td class="px-4 py-2.5 font-mono text-white">{ idx.Name }</td>
											<td class="px-4 py-2.5 font-mono text-[#87d1ff]">{ idx.Columns }</td>
											<td class="px-4 py-2.5 font-mono text-zinc-400">{ idx.IndexType }</td>
											<td class="px-4 py-2.5">
												if idx.IsUnique {
													<span class="px-2 py-0.5 rounded bg-[#7dff95]/10 border border-[#7dff95]/20 text-[#7dff95] text-[10px] font-bold">UNIQUE</span>
												} else {
													<span class="px-2 py-0.5 rounded bg-[#252525] text-zinc-300 text-[10px]">NON-UNIQUE</span>
												}
											</td>
										</tr>
									}
								} else {
									<tr>
										<td colspan="4" class="px-4 py-5 text-center text-zinc-500">Tidak ada index terdaftar.</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
}
