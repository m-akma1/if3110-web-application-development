package components

import (
	"fmt"
	"dbplatform/app/domain"
)

templ DataGrid(data domain.TableDataResult) {
	<div id="data-grid-container" class="space-y-4">
		<div class="flex items-center justify-between">
			<h2 class="text-lg font-bold text-white flex items-center gap-2">
				<span>Tabel:</span>
				<span class="text-[#ceafa3] font-mono">{ data.TableName }</span>
			</h2>
			<span class="text-xs text-zinc-400 bg-[#1a1a1a] px-3 py-1 rounded-lg border border-[#2a2a2a]">
				{ fmt.Sprintf("%d Total Baris", data.TotalRows) }
			</span>
		</div>

		<div class="bg-[#1a1a1a] border border-[#2a2a2a] rounded-xl overflow-hidden shadow-xl">
			<div class="overflow-x-auto">
				<table class="w-full text-left text-sm text-zinc-300">
					<thead class="bg-[#121212] text-xs uppercase tracking-wider text-zinc-400 border-b border-[#2a2a2a]">
						<tr>
							for _, col := range data.Columns {
								<th class="px-4 py-3 font-semibold">{ col }</th>
							}
						</tr>
					</thead>
					<tbody class="divide-y divide-[#2a2a2a]">
						if len(data.Rows) > 0 {
							for _, row := range data.Rows {
								<tr class="hover:bg-[#252525]/50 transition">
									for _, val := range row {
										<td class="px-4 py-3 whitespace-nowrap font-mono text-xs">{ val }</td>
									}
								</tr>
							}
						} else {
							<tr>
								<td colspan={ fmt.Sprintf("%d", len(data.Columns)) } class="px-4 py-8 text-center text-zinc-500">
									Tabel ini tidak memiliki data.
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>

			<div class="p-4 border-t border-[#2a2a2a] flex items-center justify-between text-xs text-zinc-400">
				<span>Halaman { fmt.Sprintf("%d dari %d", data.CurrentPage, data.TotalPages) }</span>
				<div class="flex gap-2">
					<button 
						disabled?={ data.CurrentPage <= 1 }
						hx-get={ fmt.Sprintf("/dashboard/table?name=%s&page=%d", data.TableName, data.CurrentPage-1) }
						hx-target="#data-grid-container"
						hx-swap="outerHTML"
						class="px-3 py-1.5 rounded bg-[#252525] hover:bg-[#333] disabled:opacity-40 text-white transition"
					>
						Sebelumnya
					</button>
					<button 
						disabled?={ data.CurrentPage >= data.TotalPages }
						hx-get={ fmt.Sprintf("/dashboard/table?name=%s&page=%d", data.TableName, data.CurrentPage+1) }
						hx-target="#data-grid-container"
						hx-swap="outerHTML"
						class="px-3 py-1.5 rounded bg-[#252525] hover:bg-[#333] disabled:opacity-40 text-white transition"
					>
						Selanjutnya
					</button>
				</div>
			</div>
		</div>
	</div>
}