          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, job_type) (rate(dbplatform_migration_run_seconds_bucket[1m])))",
          "legendFormat": "p50 {{job_type}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(dbplatform_migration_run_seconds_bucket[1m])))",
          "legendFormat": "p95 {{job_type}}"
        }
