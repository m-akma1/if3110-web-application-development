localhost {
    tls internal

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>Cookie delete
                request>headers>Authorization delete
                resp_headers>Set-Cookie delete
            }
        }
    }

    # mengarahkan seluruh request (UI GOTTH & API) ke Go App server
    handle /* {
        reverse_proxy app:8080
    }
}
