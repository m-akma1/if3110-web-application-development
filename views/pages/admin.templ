package pages

import (
	"dbplatform/domain"
	"dbplatform/views/layouts"
	"fmt"
)

// Shared form styles for the admin console.
const (
	adminInput  = "w-full px-3 py-2 bg-app-input border border-app-border rounded-xl text-xs text-white placeholder:text-zinc-500 focus:ring-2 focus:ring-brand-primary/50 focus:border-brand-primary focus:outline-none"
	adminSelect = "bg-app-input border border-app-border text-zinc-200 text-xs rounded-lg px-2 py-1.5 focus:outline-none focus:border-brand-primary"
	adminLabel  = "block text-xs font-medium text-zinc-300 mb-1"
	btnPrimary  = "px-3 py-2 rounded-xl bg-brand-primary hover:bg-brand-primary-hover text-app-bg text-xs font-bold transition cursor-pointer"
	btnSmall    = "px-2.5 py-1 rounded-lg bg-app-active hover:bg-app-border-strong text-zinc-200 text-[11px] font-semibold transition cursor-pointer"
	btnDanger   = "px-2.5 py-1 rounded-lg bg-sem-danger/10 hover:bg-sem-danger/20 text-sem-danger text-[11px] font-semibold border border-sem-danger/30 transition cursor-pointer"
)

// Admin is the Platform Admin console. Platform Admin manages the platform; it is not a
// database access level, so admins reach databases only through their groups like anyone else.
templ Admin(user *domain.AuthLayoutUser, activeDBID string, tab string, actorID string, ov domain.AdminOverview, csrfToken string) {
	@layouts.Dashboard("Platform Admin", user, activeDBID, "admin", csrfToken) {
		<div class="space-y-6" x-data={ fmt.Sprintf("{ activeTab: '%s' }", tab) }>
			<div>
				<h1 class="text-2xl font-bold text-white tracking-tight">Platform Administration</h1>
				<p class="text-zinc-400 mt-1 text-xs">
					Kelola pengguna, group, koneksi database, dan kode undangan. Akses database diberikan per group;
					setiap user selalu menjadi anggota group Public.
				</p>
			</div>

			<div class="flex flex-wrap gap-2 border-b border-app-border pb-3">
				@adminTabButton("users", "Pengguna")
				@adminTabButton("groups", "Group & Akses")
				@adminTabButton("databases", "Koneksi Database")
				@adminTabButton("codes", "Kode Undangan")
			</div>

			<div hx-target="#admin-console" hx-swap="outerHTML">
				@AdminConsole(actorID, ov, nil)
			</div>
		</div>
	}
}

// AdminConsole is the swappable body of the admin page (every admin action returns it).
templ AdminConsole(actorID string, ov domain.AdminOverview, flash *domain.Flash) {
	<div id="admin-console" class="space-y-6">
		if flash != nil && flash.Message != "" {
			@adminFlash(*flash)
		}
		<div x-show="activeTab === 'users'">
			@adminUsersSection(actorID, ov)
		</div>
		<div x-show="activeTab === 'groups'" x-cloak>
			@adminGroupsSection(ov)
		</div>
		<div x-show="activeTab === 'databases'" x-cloak>
			@adminTargetsSection(ov)
		</div>
		<div x-show="activeTab === 'codes'" x-cloak>
			@adminCodesSection(ov)
		</div>
	</div>
}

templ adminFlash(f domain.Flash) {
	if f.Success {
		<div role="status" class="p-3 rounded-xl bg-sem-success/10 border border-sem-success/30 text-sem-success text-xs">{ f.Message }</div>
	} else {
		<div role="alert" class="p-3 rounded-xl bg-sem-danger/10 border border-sem-danger/30 text-sem-danger text-xs">{ f.Message }</div>
	}
}

templ adminTabButton(key string, label string) {
	<button
		type="button"
		@click={ "activeTab = '" + key + "'; history.replaceState(null, '', '/admin?tab=" + key + "')" }
		:class={ "activeTab === '" + key + "' ? 'bg-brand-primary text-app-bg font-bold' : 'text-zinc-400 hover:bg-app-hover hover:text-zinc-200'" }
		class="px-4 py-2 rounded-xl text-xs transition cursor-pointer"
	>
		{ label }
	</button>
}

templ adminCard(title string, subtitle string) {
	<div class="bg-app-card border border-app-border rounded-2xl overflow-hidden shadow-xl">
		<div class="px-4 py-3 bg-app-input border-b border-app-border flex items-center justify-between gap-3">
			<span class="text-xs font-bold text-white uppercase tracking-wider">{ title }</span>
			if subtitle != "" {
				<span class="text-[10px] text-zinc-400">{ subtitle }</span>
			}
		</div>
		<div class="overflow-x-auto">
			{ children... }
		</div>
	</div>
}

func levelLabel(level string) string {
	switch level {
	case "VIEW_EDIT":
		return "View + Edit"
	case "VIEW_ONLY":
		return "View Only"
	default:
		return "Tanpa akses"
	}
}
