package pages

import (
	"regexp"
	"strings"

	"dbplatform/domain"
	"dbplatform/views/components"
	"dbplatform/views/layouts"
)

type tableGroup struct {
	Schema string
	Tables []domain.TableSummary
}

// groupBySchema keeps the order of tables (sorted by schema, then name) and starts a new
// group whenever the schema changes.
func groupBySchema(tables []domain.TableSummary) []tableGroup {
	var out []tableGroup
	for _, t := range tables {
		if len(out) == 0 || out[len(out)-1].Schema != t.Schema {
			out = append(out, tableGroup{Schema: t.Schema})
		}
		out[len(out)-1].Tables = append(out[len(out)-1].Tables, t)
	}
	return out
}

func tableKey(schema, name string) string { return schema + "." + name }

func selectedKey(view domain.ViewerPageView) string {
	for _, t := range view.Tables {
		if t.IsSelected {
			return tableKey(t.Schema, t.Name)
		}
	}
	return ""
}

var plainIdentRe = regexp.MustCompile(`^[a-z_][a-z0-9_]*$`)

func sqlIdent(s string) string {
	if plainIdentRe.MatchString(s) {
		return s
	}
	return `"` + strings.ReplaceAll(s, `"`, `""`) + `"`
}

// starterQuery pre-fills the Query Explorer with a query on the first table.
func starterQuery(view domain.ViewerPageView) string {
	if len(view.Tables) == 0 {
		return ""
	}
	t := view.Tables[0]
	name := sqlIdent(t.Name)
	if t.Schema != "public" {
		name = sqlIdent(t.Schema) + "." + name
	}
	return "SELECT * FROM " + name + " LIMIT 25;"
}

func databaseLabel(view domain.ViewerPageView) string {
	if view.DatabaseName != "" {
		return view.DatabaseName
	}
	return view.DatabaseID
}

templ Dashboard(user *domain.AuthLayoutUser, view domain.ViewerPageView, csrfToken string) {
	@layouts.Dashboard("Database Viewer", user, view.DatabaseID, "viewer", csrfToken) {
		if view.DatabaseID == "" {
			@components.NoDatabaseAccess(user)
		} else if view.Error != "" {
			@components.ErrorState("Database tidak tersedia", view.Error, components.ViewerURL(view.DatabaseID), "")
		} else {
		<div class="flex gap-6 h-full" x-data="{ selectedTable: '' }" data-selected={ selectedKey(view) } x-init="selectedTable = $el.dataset.selected">
			<!-- Sidebar Daftar Tabel, dikelompokkan per schema -->
			<div class="w-60 bg-app-card border border-app-border rounded-2xl p-4 flex flex-col shrink-0">
				<h3 class="text-xs font-bold text-zinc-400 uppercase tracking-wider mb-3 px-2">Daftar Tabel</h3>
				<div class="space-y-3 overflow-y-auto flex-1">
					if len(view.Tables) == 0 {
						<p class="px-2 text-[11px] text-zinc-500">Belum ada tabel.</p>
					}
					for _, grp := range groupBySchema(view.Tables) {
						<div class="space-y-1">
							<h4 class="px-2 text-[10px] font-semibold uppercase tracking-wider text-zinc-500 font-mono">{ grp.Schema }</h4>
							for _, tbl := range grp.Tables {
								<button
									type="button"
									data-key={ tableKey(tbl.Schema, tbl.Name) }
									hx-get={ components.TableURL(view.DatabaseID, tbl.Schema, tbl.Name, 1) }
									hx-target="#data-grid-container"
									hx-swap="outerHTML"
									@click="selectedTable = $el.dataset.key"
									:class="selectedTable === $el.dataset.key ? 'bg-brand-primary/15 text-brand-primary border border-brand-primary/30 font-bold' : 'text-zinc-300 hover:bg-app-active border border-transparent'"
									class="w-full text-left px-3 py-2 rounded-xl text-xs transition flex justify-between items-center cursor-pointer"
								>
									<span class="truncate font-mono text-xs">{ tbl.Name }</span>
								</button>
							}
						</div>
					}
				</div>
			</div>

			<!-- Main Panel: Read-Only Query Runner + Data Grid -->
			<div class="flex-1 min-w-0 space-y-5">
				<!-- Read-Only SQL Query Runner dengan Live Keyword Guard -->
				<div
					class="bg-app-card border border-app-border rounded-2xl p-4 shadow-xl space-y-3"
					data-query={ starterQuery(view) }
					x-init="sqlQuery = $el.dataset.query"
					x-data="{
						sqlQuery: '',
						get forbiddenKeyword() {
							const m = this.sqlQuery.match(/\b(INSERT|UPDATE|DELETE|DROP|ALTER|TRUNCATE|CREATE|REPLACE|GRANT|REVOKE|MERGE|CALL|EXEC|EXECUTE|COPY|VACUUM)\b/i);
							return m ? m[1].toUpperCase() : '';
						},
						get hasMultiStatement() {
							const trimmed = this.sqlQuery.trim().replace(/;$/, '');
							return trimmed.includes(';');
						}
					}"
				>
					<div class="flex items-center justify-between">
						<div class="flex items-center gap-2">
							<span class="text-xs font-bold text-white uppercase tracking-wider">SQL Query Explorer</span>
							<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-brand-primary/10 text-brand-primary border border-brand-primary/20">
								SELECT Only (Read-Only Guard)
							</span>
							<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-app-input text-zinc-300 border border-app-border">
								Target DB: { databaseLabel(view) }
							</span>
						</div>
						<span class="text-xs text-zinc-400">
							Perubahan data/skema wajib melalui menu Migration
						</span>
					</div>

					<form method="post"
						hx-post="/dashboard/query"
						hx-target="#data-grid-container"
						hx-swap="outerHTML"
						class="space-y-2.5"
					>
						<input type="hidden" name="db_id" value={ view.DatabaseID }/>
						<div class="space-y-2">
							<textarea
								name="sql_query"
								rows="3"
								x-model="sqlQuery"
								placeholder="SELECT * FROM nama_tabel LIMIT 25;"
								:class="(forbiddenKeyword !== '' || hasMultiStatement) ? 'border-sem-danger focus:border-sem-danger focus:ring-sem-danger/30' : 'border-app-border focus:border-brand-primary focus:ring-brand-primary/50'"
								class="w-full px-3.5 py-2.5 text-xs font-mono rounded-lg border bg-app-input text-white placeholder:text-zinc-500 focus:outline-none focus:ring-2 transition resize-y"
							></textarea>
							<div class="flex justify-end">
								<button
									type="submit"
									:disabled="forbiddenKeyword !== '' || hasMultiStatement || sqlQuery.trim() === ''"
									class="px-4 py-2 rounded-lg bg-brand-primary hover:bg-brand-primary-hover disabled:opacity-40 disabled:cursor-not-allowed text-app-bg text-xs font-semibold transition cursor-pointer shrink-0"
								>
									Jalankan Query
								</button>
							</div>
						</div>

						<!-- Peringatan Real-Time di Frontend saat Terdeteksi Keyword Mutasi -->
						<div
							x-show="forbiddenKeyword !== ''"
							x-cloak
							class="p-2.5 rounded-lg bg-sem-danger/10 border border-sem-danger/30 text-xs text-sem-danger flex items-center gap-2"
						>
							<svg class="w-4 h-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"></path>
							</svg>
							<span>
								Perintah <strong class="font-mono underline" x-text="forbiddenKeyword"></strong> ditolak! Halaman utama hanya mengizinkan pembacaan data (<code class="font-mono">SELECT</code>).
							</span>
						</div>

						<div
							x-show="forbiddenKeyword === '' && hasMultiStatement"
							x-cloak
							class="p-2.5 rounded-lg bg-sem-warning/10 border border-sem-warning/20 text-xs text-sem-warning flex items-center gap-2"
						>
							<span>Multi-statement (<code class="font-mono">;</code>) tidak diizinkan pada Data Viewer.</span>
						</div>
					</form>
				</div>

				switch {
					case view.Selected != nil:
						@components.DataGrid(*view.Selected)
					case view.TableError != "" && len(view.Tables) > 0:
						@components.DataGridUnavailable("Gagal memuat tabel", view.TableError,
							components.TableURL(view.DatabaseID, view.Tables[0].Schema, view.Tables[0].Name, 1))
					default:
						<div id="data-grid-container">
							@components.EmptyState("Database ini belum memiliki tabel",
								"Buat tabel melalui menu Migration, atau jalankan query SELECT di atas.")
						</div>
				}
			</div>
		</div>
		}
	}
}
