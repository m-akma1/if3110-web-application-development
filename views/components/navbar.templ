package components

import "dbplatform/domain"

// accessLabel shows an access level in words.
func accessLabel(level string) string {
    switch level {
    case "VIEW_EDIT":
        return "View + Edit"
    case "VIEW_ONLY":
        return "View Only"
    default:
        return "Tanpa akses"
    }
}

// switcherPath is where the database switcher sends the user: the page they are on when it
// is database-scoped, otherwise the viewer.
func switcherPath(activeTab string) string {
    if activeTab == "migration" {
        return "/migration"
    }
    return "/dashboard"
}

// Navbar's database switcher is a plain GET form, so switching reloads the current page with
// ?db_id=... in the address bar (shareable, and back/forward work).
templ Navbar(user *domain.AuthLayoutUser, activeDBID string, activeTab string) {
    <header class="h-16 w-full border-b border-app-border px-6 flex items-center justify-between shrink-0 bg-app-sidebar">
        <div class="flex items-center gap-3">
            <span class="text-xs font-semibold text-zinc-400 uppercase tracking-wider">Database:</span>
            if user != nil && len(user.Databases) > 0 {
                <form method="get" action={ templ.SafeURL(switcherPath(activeTab)) } id="db-switcher">
                    <select 
                        name="db_id" 
                        aria-label="Pilih database"
                        onchange="this.form.submit()"
                        class="bg-app-input border border-app-border text-zinc-200 text-xs font-mono rounded-xl px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-brand-primary/50"
                    >
                        for _, db := range user.Databases {
                            <option value={ db.DatabaseID } selected?={ db.DatabaseID == activeDBID }>
                                { db.DatabaseName } - { accessLabel(db.EffectiveAccess) }
                            </option>
                        }
                    </select>
                    <noscript><button type="submit" class="ml-1 text-xs text-brand-primary">Buka</button></noscript>
                </form>
            } else {
                <span class="text-xs text-sem-warning font-mono bg-sem-warning/10 px-2.5 py-1 rounded-md border border-sem-warning/20">
                    Belum ada akses database
                </span>
            }
        </div>

        <div class="flex items-center gap-2.5">
            if user != nil {
                if user.IsPlatformAdmin {
                    <span class="text-[10px] font-bold tracking-wider uppercase bg-brand-primary text-app-bg px-2.5 py-1 rounded-lg">
                        ADMIN
                    </span>
                }
                <span class="text-xs font-semibold text-zinc-200">{ user.Username }</span>
            } else {
                <span class="text-xs font-medium text-zinc-400">Guest</span>
            }
        </div>
    </header>
}