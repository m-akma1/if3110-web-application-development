package components

import "if3110-web-application-development/authn"

templ Navbar(user *authn.AuthLayoutUser, activeDBID string) {
    <header class="h-16 w-full bg-slate-800/50 border-b border-slate-700/60 px-6 flex items-center justify-between shrink-0">
        <!-- Selector Database Target -->
        <div class="flex items-center gap-3">
            <span class="text-sm font-medium text-slate-400">Database:</span>
            if user != nil && len(user.Databases) > 0 {
                <select 
                    name="db_id" 
                    hx-get="/dashboard/select-db" 
                    hx-target="body"
                    class="bg-slate-900 border border-slate-700 text-slate-200 text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                    for _, db := range user.Databases {
                        <option value={ db.DatabaseID } selected?={ db.DatabaseID == activeDBID }>
                            { db.DatabaseName } ({ db.DBMS }) - { db.EffectiveAccess }
                        </option>
                    }
                </select>
            } else {
                <span class="text-xs text-amber-400 font-mono bg-amber-500/10 px-2.5 py-1 rounded-md border border-amber-500/20">
                    Tidak ada akses DB
                </span>
            }
        </div>

        <!-- User Profile & Badge Role -->
        <div class="flex items-center gap-3">
            if user != nil {
                if user.IsPlatformAdmin {
                    <span class="text-[10px] font-bold tracking-wider uppercase bg-blue-500/20 text-blue-400 border border-blue-500/30 px-2 py-0.5 rounded">
                        Admin
                    </span>
                }
                <div class="w-8 h-8 rounded-full bg-slate-700 border border-slate-600 flex items-center justify-center text-sm font-bold text-white">
                    { string(user.Username[0]) }
                </div>
                <span class="text-sm font-medium text-slate-200">{ user.Username }</span>
            } else {
                <div class="w-8 h-8 rounded-full bg-slate-700 border border-slate-600 flex items-center justify-center text-sm font-bold text-white">
                    U
                </div>
                <span class="text-sm font-medium text-slate-200">Guest</span>
            }
        </div>
    </header>
}