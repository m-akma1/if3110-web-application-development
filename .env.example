# All variables are REQUIRED unless marked optional

# Application Internal database
# 
POSTGRES_USER=if3110
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=dbplatform_core
# Optional
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=disable

# Public Target Database
# superuser, only used by the target-postgres container
TARGET_POSTGRES_USER=target_admin
TARGET_POSTGRES_PASSWORD=change-me-target-admin
TARGET_POSTGRES_DB=demo_target

# Regular user role the platform uses to connect to the target
# The demo database is registered from these values when SEED_DEMO_DATA=true
TARGET_APP_USER=app_target
TARGET_APP_PASSWORD=change-me-app-target
# Optional
# TARGET_POSTGRES_HOST=target-postgres
# TARGET_POSTGRES_PORT=5432
# TARGET_POSTGRES_SSLMODE=disable

# Encryption key for target database passwords
# Generate with openssl rand -base64 32
# Do not change once injected
TARGET_CREDENTIALS_KEY=change-me-credentials-key

# Optional: read-only query limits in the Data Viewer
QUERY_TIMEOUT_MS=5000
QUERY_ROW_LIMIT=500

# Optional: migration execution limits
MIGRATION_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=60000
MIGRATION_QUEUE_TIMEOUT_MS=15000

# Optional: session handling parameters
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_EXPIRATION_HOURS=12
SESSION_ROTATION_INTERVAL_MINUTES=15
SESSION_GRACE_PERIOD_SECONDS=15

# Initial platform admin
# Required as long as there is no active Platform Admin, may be left empty afterwards. 
# Created only once, never overwrites an existing account.
# Fields: username, password, email (optional). Written as a JSON array.
BOOTSTRAP_ADMINS='[
  {
    "username":"admin",
    "password":"change-me-admin-password",
    "email":"admin@example.com"
  }
]'

# Demo data (optional, insert-only). If true, SEED_DEMO_USERS and TARGET_APP_* are required.
SEED_DEMO_DATA=true
# Fields: username, password, email (optional), role (USER | PLATFORM_ADMIN, default USER)

SEED_DEMO_USERS='[
  {
    "username":"moreno",
    "password":"change-me-moreno",
    "email":"moreno@example.com",
    "role":"PLATFORM_ADMIN"
  },
  {
    "username":"dzaki",
    "password":"change-me-dzaki",
    "email":"dzaki@example.com"
  },
  {
    "username":"akmal",
    "password":"change-me-akmal"
  }
]'

# Optional
# Fields: name, description, invite_code, 
# grant (NONE | VIEW_ONLY | VIEW_EDIT on the demo database), 
# members (usernames from SEED_DEMO_USERS). 
SEED_DEMO_GROUPS='[
  {
    "name":"Data Engineers",
    "description":"Able to view and edit.",
    "invite_code":"CHANGE-ME-ENGINEERS",
    "grant":"VIEW_EDIT",
    "members":["bob"]
  },
  {
    "name":"Data Analysts",
    "description":"Only able to view.",
    "invite_code":"CHANGE-ME-ANALYSTS",
    "grant":"VIEW_ONLY",
    "members":["carol"]
  }
]'

# Integration test for `make test-integration`
TEST_DATABASE_URL=postgres://test:test@localhost:5433/dbplatform_test?sslmode=disable