# Database Internal Aplikasi
POSTGRES_USER=if3110
POSTGRES_PASSWORD=webdev-sangat-mengasyikkan
POSTGRES_DB=dbplatform_core
DATABASE_URL=postgres://if3110:webdev-sangat-mengasyikkan@postgres:5432/dbplatform_core?sslmode=disable

# Database Target Demo
TARGET_POSTGRES_USER=target_admin
TARGET_POSTGRES_PASSWORD=change-me-target-admin
TARGET_POSTGRES_DB=demo_target

# Role non-superuser yang dipakai platform untuk terhubung ke target
TARGET_APP_USER=app_target
TARGET_APP_PASSWORD=change-me-app-target
DEMO_TARGET_URL=postgres://app_target:change-me-app-target@target-postgres:5432/demo_target?sslmode=disable

# Batas kueri Read-Only pada Data Viewer
QUERY_TIMEOUT_MS=5000
QUERY_ROW_LIMIT=500

# Batas eksekusi migration
MIGRATION_LOCK_TIMEOUT_MS=5000
MIGRATION_STATEMENT_TIMEOUT_MS=60000
MIGRATION_QUEUE_TIMEOUT_MS=15000

# Parameter Session Handling
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_EXPIRATION_HOURS=12
SESSION_ROTATION_INTERVAL_MINUTES=15
SESSION_GRACE_PERIOD_SECONDS=15

# Platform Admin awal
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Data demo (opsional, insert-only)
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=change-me-demo-password

# Integration test untuk `make test-integration`
TEST_DATABASE_URL=postgres://test:test@localhost:5433/dbplatform_test?sslmode=disable
