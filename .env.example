# Database Internal Aplikasi
POSTGRES_USER=dbplatform
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=dbplatform_core
DATABASE_URL=postgres://dbplatform:supersecretpassword@postgres:5432/dbplatform_core?sslmode=disable

# Parameter Session Handling (Didokumentasikan Tim)
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_EXPIRATION_HOURS=12
SESSION_ROTATION_INTERVAL_MINUTES=15
SESSION_GRACE_PERIOD_SECONDS=15

# Keamanan
CSRF_SECRET_KEY=32-byte-long-secret-key-for-csrf
