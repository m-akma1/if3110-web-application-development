package pages

import (
	"dbplatform/frontend/authn"
	"dbplatform/frontend/views/layouts"
)

templ Dashboard(user *authn.AuthLayoutUser, activeDBID string) {
	@layouts.Dashboard("Database Viewer", user, activeDBID, "viewer") {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<div>
					<h1 class="text-2xl font-bold text-white">Database Viewer</h1>
					<p class="text-slate-400 mt-1">Pilih tabel dari skema untuk melihat kolom, indeks, dan isi data.</p>
				</div>
			</div>

			<div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-8 text-center">
				<div class="max-w-md mx-auto space-y-3">
					<div class="w-12 h-12 rounded-xl bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center mx-auto text-xl font-bold">
						DB
					</div>
					<h3 class="text-lg font-semibold text-white">Siap Terhubung ke Target DB</h3>
					<p class="text-sm text-slate-400">
						Komponen layout dan otorisasi UI siap dikoneksikan dengan engine Database Viewer backend.
					</p>
				</div>
			</div>
		</div>
	}
}